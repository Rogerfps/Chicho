@model List<CarGoCR.Models.Proforma>

@{
    var hoy = DateTime.UtcNow;

    // ── Stats ──────────────────────────────────────────────────────────────────
    decimal ingresosMes = Model
    .Where(x => x.Pagada && x.FechaCreacion.Year == hoy.Year && x.FechaCreacion.Month == hoy.Month)
    .Sum(x => x.Total);

    int totalVentas = Model.Count(x => x.Pagada);

    int clientesActivos = Model
    .Where(x => x.ClienteId > 0)
    .Select(x => x.ClienteId)
    .Distinct()
    .Count();

    int paquetesTransito = Model
    .SelectMany(p => p.Detalles)
    .Where(d => d.Paquete?.Estado == "En tránsito")
    .Count();

    // ── Line chart: ingresos últimos 12 meses ─────────────────────────────────
    var tendencia12 = Enumerable.Range(0, 12)
    .Select(i =>
    {
        var fecha = hoy.AddMonths(-11 + i);
        return new
        {
            Mes = fecha.ToString("MMM"),
            Total = Model
      .Where(x => x.Pagada
      && x.FechaCreacion.Year == fecha.Year
      && x.FechaCreacion.Month == fecha.Month)
      .Sum(x => x.Total),
            Ventas = Model
      .Count(x => x.Pagada
      && x.FechaCreacion.Year == fecha.Year
      && x.FechaCreacion.Month == fecha.Month)
        };
    }).ToList();

    string mesesJson = System.Text.Json.JsonSerializer.Serialize(tendencia12.Select(x => x.Mes));
    string ingresosJson = System.Text.Json.JsonSerializer.Serialize(tendencia12.Select(x => x.Total));
    string ventasJson = System.Text.Json.JsonSerializer.Serialize(tendencia12.Select(x => x.Ventas));

    // ── Donut chart: top 5 categorías por ingresos ────────────────────────────
    var topCategorias = Model
    .SelectMany(p => p.Detalles)
    .Where(d => d.Paquete?.Tarifa != null)
    .GroupBy(d => d.Paquete!.Tarifa!.Categoria)
    .Select(g => new
    {
        Categoria = g.Key,
        Total = g.Sum(d => d.Precio)
    })
    .OrderByDescending(x => x.Total)
    .Take(5)
    .ToList();

    decimal totalCats = topCategorias.Sum(x => x.Total);

    string donutLabelsJson = System.Text.Json.JsonSerializer.Serialize(topCategorias.Select(x => x.Categoria));
    string donutValoresJson = System.Text.Json.JsonSerializer.Serialize(topCategorias.Select(x => x.Total));
    string donutPctJson = System.Text.Json.JsonSerializer.Serialize(
    topCategorias.Select(x => totalCats > 0
    ? Math.Round(x.Total / totalCats * 100, 0)
    : 0));

    var donutColores = new[] { "#4f7cff", "#fb923c", "#34d399", "#fbbf24", "#f87171" };
    // ── Ventas por semana del mes actual ─────────────────────────────────────
    var semanas = Enumerable.Range(1, 4).Select(s => new
    {
        Semana = $"Semana {s}",
        Total = Model
            .Where(x => x.Pagada
                     && x.FechaCreacion.Year == hoy.Year
                     && x.FechaCreacion.Month == hoy.Month
                     && (int)Math.Ceiling(x.FechaCreacion.Day / 7.0) == s)
            .Sum(x => x.Total)
    }).ToList();

    string semanasJson = System.Text.Json.JsonSerializer.Serialize(semanas.Select(x => x.Semana));
    string semanasTotalsJson = System.Text.Json.JsonSerializer.Serialize(semanas.Select(x => x.Total));
}

<!-- MAIN -->
<div class="main">
    <div class="content">
        <div class="page-header-row">
            <div class="page-header">
                <h1>Dashboard</h1>
                <p>Resumen general del rendimiento de tu negocio</p>
            </div>

        </div>

        <!-- STATS -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-top">
                    <div class="stat-icon blue">
                        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <line x1="12" y1="1" x2="12" y2="23" />
                            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                        </svg>
                    </div>
                </div>
                <div class="stat-value">₡@ingresosMes.ToString("N0")</div>
                <div class="stat-label">Ingresos del mes</div>
            </div>
            <div class="stat-card">
                <div class="stat-top">
                    <div class="stat-icon green">
                        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <circle cx="9" cy="21" r="1" />
                            <circle cx="20" cy="21" r="1" />
                            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
                        </svg>
                    </div>
                </div>
                <div class="stat-value">@totalVentas</div>
                <div class="stat-label">Ventas</div>
            </div>
            <div class="stat-card">
                <div class="stat-top">
                    <div class="stat-icon purple">
                        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                            <circle cx="9" cy="7" r="4" />
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                            <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                        </svg>
                    </div>
                </div>
                <div class="stat-value">@clientesActivos</div>
                <div class="stat-label">Clientes activos</div>
            </div>
            <div class="stat-card">
                <div class="stat-top">
                    <div class="stat-icon orange">
                        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
                        </svg>
                    </div>
                </div>
                <div class="stat-value">@paquetesTransito</div>
                <div class="stat-label">Paquetes en tránsito</div>
            </div>
        </div>

        <!-- CHARTS -->
        <div class="charts-row">
            <div class="chart-card">
                <div class="chart-header">
                    <div>
                        <div class="chart-title">Ingresos y ventas</div>
                        <div class="chart-sub">Últimos 12 meses</div>
                    </div>
                    <span class="chart-badge">↑ +24.8%</span>
                </div>
                <div class="chart-wrap"><canvas id="lineChart"></canvas></div>
            </div>

            <div class="chart-card">
                <div class="chart-header">
                    <div>
                        <div class="chart-title">Por categoría</div>
                        <div class="chart-sub">Top 5 categorías por ingresos</div>
                    </div>
                </div>
                @if (topCategorias.Any())
                {
                    <div class="donut-wrap"><canvas id="donutChart"></canvas></div>
                    <div class="legend" id="donut-legend">
                        @for (int i = 0; i < topCategorias.Count; i++)
                        {
                            var pct = totalCats > 0
                          ? Math.Round(topCategorias[i].Total / totalCats * 100, 0)
                          : 0;
                            <div class="legend-item">
                                <div class="legend-dot-label">
                                    <div class="legend-dot" style="background:@donutColores[i]"></div>
                                    @topCategorias[i].Categoria
                                </div>
                                <span class="legend-pct">@pct%</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div style="display:flex;align-items:center;justify-content:center;height:180px;color:var(--text-muted);font-size:0.875rem;">
                        Sin datos de categorías aún
                    </div>
                }
            </div>
            <div class="chart-card" style="grid-column: 1 / -1;">
                <div class="chart-header">
                    <div>
                        <div class="chart-title">Ventas por semana</div>
                        <div class="chart-sub">@hoy.ToString("MMMM yyyy")</div>
                    </div>
                </div>
                <div class="chart-wrap"><canvas id="semanasChart"></canvas></div>
            </div>
        </div>

    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>
<script>
    (function () {
    const isMobile = window.innerWidth <= 768;
    const chartH   = isMobile ? 200 : 220;
    const donutH   = isMobile ? 160 : 180;

    // Forzar altura de los wrappers antes de que Chart.js lea el DOM
    document.querySelectorAll('.chart-wrap').forEach(el => {
    el.style.height = chartH + 'px';
    });
    document.querySelectorAll('.donut-wrap').forEach(el => {
    el.style.height = donutH + 'px';
    });

    // ── Line chart ─────────────────────────────────────────────────────────────
    const meses    = @Html.Raw(mesesJson);
    const ingresos = @Html.Raw(ingresosJson);
    const ventas   = @Html.Raw(ventasJson);

    const ctx1  = document.getElementById('lineChart').getContext('2d');
    const grad1 = ctx1.createLinearGradient(0, 0, 0, chartH);
    grad1.addColorStop(0, 'rgba(79,124,255,0.3)');
    grad1.addColorStop(1, 'rgba(79,124,255,0)');
    const grad2 = ctx1.createLinearGradient(0, 0, 0, chartH);
    grad2.addColorStop(0, 'rgba(167,139,250,0.2)');
    grad2.addColorStop(1, 'rgba(167,139,250,0)');

    new Chart(ctx1, {
    type: 'line',
    data: {
    labels: meses,
    datasets: [
    {
    label: 'Ingresos',
    data: ingresos,
    borderColor: '#4f7cff',
    backgroundColor: grad1,
    borderWidth: 2,
    pointBackgroundColor: '#4f7cff',
    pointRadius: isMobile ? 2 : 3,
    tension: 0.4,
    fill: true
    },
    {
    label: 'Ventas',
    data: ventas,
    borderColor: '#a78bfa',
    backgroundColor: grad2,
    borderWidth: 2,
    pointBackgroundColor: '#a78bfa',
    pointRadius: isMobile ? 2 : 3,
    tension: 0.4,
    fill: true
    }
    ]
    },
    options: {
    responsive: true,
    maintainAspectRatio: false,
    plugins: { legend: { display: false } },
    scales: {
    x: {
    grid: { color: 'rgba(255,255,255,0.04)' },
    ticks: {
    color: '#7b8099',
    font: { size: isMobile ? 9 : 11 },
    maxRotation: 0,
    maxTicksLimit: isMobile ? 6 : 12
    }
    },
    y: {
    grid: { color: 'rgba(255,255,255,0.04)' },
    ticks: {
    color: '#7b8099',
    font: { size: isMobile ? 9 : 11 },
    maxTicksLimit: isMobile ? 4 : 6,
    callback: v => isMobile
    ? '₡' + (v >= 1000 ? (v/1000).toFixed(0) + 'k' : v)
    : '₡' + v.toLocaleString('es-CR')
    },
    min: 0
    }
    }
    }
    });

    // ── Donut chart ────────────────────────────────────────────────────────────
    const donutCanvas = document.getElementById('donutChart');
    if (donutCanvas) {
    const donutLabels  = @Html.Raw(donutLabelsJson);
    const donutValores = @Html.Raw(donutValoresJson);
    const donutColores = ['#4f7cff','#fb923c','#34d399','#fbbf24','#f87171'];

    new Chart(donutCanvas.getContext('2d'), {
    type: 'doughnut',
    data: {
    datasets: [{
    data: donutValores,
    backgroundColor: donutColores.slice(0, donutLabels.length),
    borderWidth: 0,
    hoverOffset: 4
    }]
    },
    options: {
    responsive: true,
    maintainAspectRatio: false,
    plugins: {
    legend: { display: false },
    tooltip: {
    callbacks: {
    label: ctx => {
    const label = donutLabels[ctx.dataIndex];
    const val   = ctx.parsed;
    const total = ctx.dataset.data.reduce((a, b) => a + b, 0);
    const pct   = total > 0 ? ((val / total) * 100).toFixed(0) : 0;
    return ` ${label}: ${pct}%`;
    }
    }
    }
    },
    cutout: '68%'
    }
    });
    }

    // ── Bar chart semanas ──────────────────────────────────────────────────────
    const semanasLabels = @Html.Raw(semanasJson);
    const semanasTotals = @Html.Raw(semanasTotalsJson);

    new Chart(document.getElementById('semanasChart').getContext('2d'), {
    type: 'bar',
    data: {
    labels: semanasLabels,
    datasets: [{
    label: 'Ingresos',
    data: semanasTotals,
    backgroundColor: [
    'rgba(79,124,255,0.85)',
    'rgba(79,124,255,0.65)',
    'rgba(79,124,255,0.45)',
    'rgba(79,124,255,0.25)'
    ],
    borderRadius: 6,
    borderSkipped: false
    }]
    },
    options: {
    responsive: true,
    maintainAspectRatio: false,
    plugins: {
    legend: { display: false },
    tooltip: {
    callbacks: {
    label: ctx => ' ₡' + ctx.parsed.y.toLocaleString('es-CR', { minimumFractionDigits: 2 })
    }
    }
    },
    scales: {
    x: {
    grid: { color: 'rgba(255,255,255,0.04)' },
    ticks: { color: '#7b8099', font: { size: isMobile ? 10 : 11 } }
    },
    y: {
    grid: { color: 'rgba(255,255,255,0.04)' },
    ticks: {
    color: '#7b8099',
    font: { size: isMobile ? 9 : 11 },
    maxTicksLimit: isMobile ? 4 : 6,
    callback: v => isMobile
    ? '₡' + (v >= 1000 ? (v/1000).toFixed(0) + 'k' : v)
    : '₡' + v.toLocaleString('es-CR')
    },
    min: 0
    }
    }
    }
    });

    // Redibujado al rotar pantalla
    window.addEventListener('resize', () => {
    Chart.instances.forEach(c => c.resize());
    });
    })();
</script>