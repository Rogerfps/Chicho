@model CarGoCR.Models.Empresa

@{
    ViewData["Title"] = "Empresa";
}


<link rel="stylesheet" href="~/css/Empresa/Index.css" asp-append-version="true" />

<form asp-action="Index"
      method="post"
      enctype="multipart/form-data">

    <input type="hidden" asp-for="Id" />


        <div class="content">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success mb-3">
                    @TempData["Success"]
                </div>
            }

            <div class="page-header-row">
                <div class="page-header">
                    <h1>Empresa</h1>
                    <p>Configuración general de CarGoCR</p>
                </div>

                <button type="submit" class="btn-primary">
                    Guardar cambios
                </button>
            </div>

            <div class="empresa-grid">

                <!-- IZQUIERDA -->
                <div>

                    <div class="card">

                        <div class="card-title">
                            Identidad corporativa
                        </div>

                        <div class="logo-upload">

                            @if (!string.IsNullOrEmpty(Model.Logo))
                            {
                                <img src="@Model.Logo"
                                     style="width:90px;height:90px;object-fit:contain;border-radius:10px;" />
                            }
                            else
                            {
                                <div class="logo-placeholder">
                                    LOGO
                                </div>
                            }

                            <div class="logo-info">
                                <div class="logo-info-title">
                                    Logo de la empresa
                                </div>

                                <div class="logo-info-sub">
                                    PNG, JPG o SVG
                                </div>
                            </div>

                            <input type="file"
                                   name="archivoLogo"
                                   class="form-input" />
                        </div>

                        <div class="form-grid">

                            <div class="form-group">
                                <label class="form-label">
                                    Nombre de la empresa
                                </label>

                                <input asp-for="NombreEmpresa"
                                       class="form-input" />
                            </div>

                            <div class="form-group">
                                <label class="form-label">
                                    Razón social
                                </label>

                                <input asp-for="RazonSocial"
                                       class="form-input" />
                            </div>

                            <div class="form-group">
                                <label class="form-label">
                                    Cédula jurídica
                                </label>

                                <input asp-for="CedulaJuridica"
                                       class="form-input" />
                            </div>

                            <div class="form-group">
                                <label class="form-label">
                                    Industria
                                </label>

                                <input asp-for="Industria"
                                       class="form-input" />
                            </div>

                            <div class="form-group full">
                                <label class="form-label">
                                    Descripción
                                </label>

                                <textarea asp-for="Descripcion"
                                          rows="4"
                                          class="form-input"></textarea>
                            </div>

                        </div>

                    </div>

                    <div class="bottom-grid">

                        <!-- REDES -->

                        <div class="card">

                            <div class="card-title">
                                Redes Sociales
                            </div>

                            <div class="form-group">
                                <label class="form-label">
                                    Instagram
                                </label>

                                <input asp-for="Instagram"
                                       class="form-input" />
                            </div>

                            <br />

                            <div class="form-group">
                                <label class="form-label">
                                    Facebook
                                </label>

                                <input asp-for="Facebook"
                                       class="form-input" />
                            </div>

                            <br />

                            <div class="form-group">
                                <label class="form-label">
                                    Twitter / X
                                </label>

                                <input asp-for="Twitter"
                                       class="form-input" />
                            </div>

                        </div>

                        <!-- MONEDA -->

                        <div class="card">

                            <div class="card-title">
                                Monedas
                            </div>

                            <div class="form-group">
                                <label class="form-label">
                                    Moneda principal
                                </label>

                                <input asp-for="MonedaPrincipal"
                                       class="form-input" />
                            </div>

                            <br />

                            <div class="form-group">
                                <label class="form-label">
                                    Moneda secundaria
                                </label>

                                <input asp-for="MonedaSecundaria"
                                       class="form-input" />
                            </div>

                            <br />

                            <div class="form-group">
                                <label class="form-label">
                                    Tipo de cambio
                                </label>

                                <input asp-for="TipoCambio"
                                       type="number"
                                       step="0.01"
                                       class="form-input" />
                            </div>

                        </div>

                        <!-- IMPUESTOS -->

                        <div class="card">

                            <div class="card-title">
                                Impuestos
                            </div>

                            <div class="form-group">
                                <label class="form-label">
                                    IVA (%)
                                </label>

                                <input asp-for="IVA"
                                       type="number"
                                       step="0.01"
                                       class="form-input" />
                            </div>

                            <br />

                            <div class="form-check">
                                <input asp-for="IncluirImpuestos"
                                       class="form-check-input" />

                                <label asp-for="IncluirImpuestos"
                                       class="form-check-label">
                                    Incluir impuestos
                                </label>
                            </div>

                            <br />

                            <div class="form-check">
                                <input asp-for="FacturacionElectronica"
                                       class="form-check-input" />

                                <label asp-for="FacturacionElectronica"
                                       class="form-check-label">
                                    Facturación electrónica
                                </label>
                            </div>

                        </div>

                    </div>

                </div>

                <!-- DERECHA -->

                <div class="card">

                    <div class="card-title">
                        Información de contacto
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            Correo electrónico
                        </label>

                        <input asp-for="Correo"
                               class="form-input" />
                    </div>

                    <br />

                    <div class="form-group">
                        <label class="form-label">
                            Teléfono
                        </label>

                        <input asp-for="Telefono"
                               class="form-input" />
                    </div>

                    <br />

                    <div class="form-group">
                        <label class="form-label">
                            Sitio web
                        </label>

                        <input asp-for="SitioWeb"
                               class="form-input" />
                    </div>

                </div>

            </div>

        </div>

    </div>

</form>
