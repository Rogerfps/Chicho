@model List<CarGoCR.Models.Proforma>

@{
    ViewData["Title"] = "Ventas";

    // ── Estadísticas ──────────────────────────────────────────────────────────
    int totalProformas = Model.Count;
    int pagadas        = Model.Count(x => x.Pagada);
    int pendientes     = Model.Count(x => !x.Pagada);

    decimal ingresosTotales = Model.Where(x => x.Pagada).Sum(x => x.Total);

    var hoy        = DateTime.UtcNow;
    decimal ingresosMes = Model
        .Where(x => x.Pagada && x.FechaCreacion.Year == hoy.Year && x.FechaCreacion.Month == hoy.Month)
        .Sum(x => x.Total);

    // ── Top 5 paquetes por peso ────────────────────────────────────────────────
    var topPeso = Model
        .SelectMany(p => p.Detalles)
        .Where(d => d.Paquete != null)
        .GroupBy(d => d.Paquete!.Descripcion ?? $"Paquete #{d.PaqueteId}")
        .Select(g => new { Nombre = g.Key, PesoTotal = g.Sum(d => d.Paquete!.Peso) })
        .OrderByDescending(x => x.PesoTotal)
        .Take(5)
        .ToList();

    decimal maxPeso = topPeso.Any() ? topPeso.Max(x => x.PesoTotal) : 1;

    // ── Tendencia mensual (últimos 6 meses) ────────────────────────────────────
    var tendencia = Enumerable.Range(0, 6)
        .Select(i => {
            var fecha = hoy.AddMonths(-5 + i);
            return new {
                Mes   = fecha.ToString("MMM"),
                Total = Model
                    .Where(x => x.Pagada
                             && x.FechaCreacion.Year  == fecha.Year
                             && x.FechaCreacion.Month == fecha.Month)
                    .Sum(x => x.Total)
            };
        })
        .ToList();

    string mesesJson = System.Text.Json.JsonSerializer.Serialize(tendencia.Select(x => x.Mes));
    string valoresJson = System.Text.Json.JsonSerializer.Serialize(tendencia.Select(x => x.Total));
}

<link rel="stylesheet" href="~/css/Ventas/Index.css" asp-append-version="true" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&display=swap" />
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>

<div class="ventas-wrap">

    <div class="page-header-row">
        <div class="page-header">
            <h1>Ventas</h1>
            <p>Análisis de proformas en tiempo real</p>
        </div>

    </div>

    <div class="stats-grid">

        <div class="stat-card">
            <div class="stat-label">
                <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <line x1="12" y1="1" x2="12" y2="23" />
                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                </svg>
                Ingresos totales
            </div>
            <div class="stat-value">₡@ingresosTotales.ToString("N0")</div>
            <div class="stat-sub">Solo proformas pagadas</div>
        </div>

        <div class="stat-card">
            <div class="stat-label">
                <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" />
                    <line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" />
                </svg>
                Ingresos del mes
            </div>
            <div class="stat-value">₡@ingresosMes.ToString("N0")</div>
            <div class="stat-sub">@hoy.ToString("MMMM yyyy")</div>
        </div>

        <div class="stat-card">
            <div class="stat-label">
                <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                    <polyline points="14 2 14 8 20 8" />
                </svg>
                Total proformas
            </div>
            <div class="stat-value">@totalProformas</div>
            <div class="stat-sub">
                <span class="up">@pagadas pagadas</span> · @pendientes pendientes
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-label">
                <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <polyline points="20 6 9 17 4 12" />
                </svg>
                Pagadas
            </div>
            <div class="stat-value">@pagadas</div>
            <div class="stat-sub">
                @(totalProformas > 0 ? ((decimal)pagadas / totalProformas * 100).ToString("N0") : "0")% del total
            </div>
        </div>

    </div>

    <div class="charts-row">

        <div class="chart-card">
            <div class="chart-title">Tendencia de ingresos (últimos 6 meses)</div>
            <div class="chart-wrap">
                <canvas id="ventas-chart"></canvas>
            </div>
        </div>

        <div class="chart-card">
            <div class="chart-title">Top paquetes por peso (kg)</div>
            <div class="bar-list">
                @if (topPeso.Any())
                {
                    @foreach (var item in topPeso)
                    {
                        decimal pct = maxPeso > 0 ? item.PesoTotal / maxPeso * 100 : 0;
                        <div class="bar-item">
                            <div class="bar-item-label">
                                <span class="bar-item-name" title="@item.Nombre">@item.Nombre</span>
                                <span class="bar-item-val">@item.PesoTotal.ToString("N2") kg</span>
                            </div>
                            <div class="bar-bg">
                                <div class="bar-fill" style="width:@pct.ToString("N0")%"></div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p style="font-size:0.8125rem;color:var(--text-muted);text-align:center;padding:2rem 0;">
                        Sin datos de paquetes aún
                    </p>
                }
            </div>
        </div>

    </div>

    <div class="table-card">
        <div class="table-header-row">
            <span class="table-title">Proformas</span>
            <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;">


                <div class="table-search">
                    <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" />
                    </svg>
                    <input type="text" id="buscar" placeholder="Buscar..." oninput="buscar(this.value)" />
                </div>

            </div>
        </div>

        <table class="data-table" id="tabla-proformas">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Cliente</th>
                    <th>Fecha</th>
                    <th>Paquetes</th>
                    <th>Total</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var item in Model.OrderByDescending(x => x.FechaCreacion))
                    {
                        <tr data-estado="@(item.Pagada ? "pagada" : "pendiente")"
                            data-buscar="@((item.Cliente?.NombreCompleto ?? "") + " " + item.Id)">

                            <td><span class="proforma-id">#@item.Id</span></td>

                            <td>@(item.Cliente?.NombreCompleto ?? "—")</td>

                            <td style="color:var(--text-secondary);">
                                @item.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy")
                            </td>

                            <td style="color:var(--text-secondary);">
                                @item.Detalles.Count
                            </td>

                            <td style="font-variant-numeric:tabular-nums;">
                                ₡@item.Total.ToString("N2")
                            </td>

                            <td>
                                @if (item.Pagada)
                                {
                                    <span class="badge badge-paid">Pagada</span>
                                }
                                else
                                {
                                    <span class="badge badge-pending">Pendiente</span>
                                }
                            </td>

                            <td>
                                <div class="action-buttons">

                                    <a asp-controller="Proformas" asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="action-btn" title="Ver detalle">
                                        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z" />
                                            <circle cx="12" cy="12" r="3" />
                                        </svg>
                                    </a>

                                    <a asp-controller="Proformas" asp-action="Imprimir"
                                       asp-route-id="@item.Id"
                                       class="action-btn" title="Imprimir PDF" target="_blank">
                                        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                            <polyline points="6 9 6 2 18 2 18 9" />
                                            <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2" />
                                            <rect x="6" y="14" width="12" height="8" />
                                        </svg>
                                    </a>

                                    @if (!item.Pagada)
                                    {
                                        <a asp-controller="Proformas" asp-action="Aprobar"
                                           asp-route-id="@item.Id"
                                           class="action-btn approve-btn" title="Confirmar pago">
                                            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                <polyline points="20 6 9 17 4 12" />
                                            </svg>
                                        </a>
                                    }

                                    <a asp-controller="Proformas" asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="action-btn delete-btn" title="Eliminar">
                                        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                            <polyline points="3 6 5 6 21 6" />
                                            <path d="M19 6l-1 14H6L5 6" />
                                            <path d="M10 11v6" /><path d="M14 11v6" />
                                            <path d="M9 6V4h6v2" />
                                        </svg>
                                    </a>

                                </div>
                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="empty-state">No hay proformas registradas</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>

<script>
    // Gráfico de tendencia
    (function () {
        const meses   = @Html.Raw(mesesJson);
        const valores = @Html.Raw(valoresJson);

        const ctx = document.getElementById('ventas-chart').getContext('2d');
        const grad = ctx.createLinearGradient(0, 0, 0, 220);
        grad.addColorStop(0, 'rgba(37,99,235,0.18)');
        grad.addColorStop(1, 'rgba(37,99,235,0)');

        new Chart(ctx, {
            type: 'line',
            data: {
                labels: meses,
                datasets: [{
                    data: valores,
                    borderColor: '#2563eb',
                    backgroundColor: grad,
                    borderWidth: 2,
                    pointBackgroundColor: '#2563eb',
                    pointRadius: 4,
                    pointHoverRadius: 6,
                    tension: 0.4,
                    fill: true
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: ctx => `₡ ${ctx.parsed.y.toLocaleString('es-CR', { minimumFractionDigits: 2 })}`
                        }
                    }
                },
                scales: {
                    x: {
                        grid: { color: 'rgba(0,0,0,0.04)' },
                        ticks: { color: '#94a3b8', font: { size: 11, family: 'DM Sans' } }
                    },
                    y: {
                        grid: { color: 'rgba(0,0,0,0.04)' },
                        ticks: {
                            color: '#94a3b8',
                            font: { size: 11, family: 'DM Sans' },
                            callback: v => '₡' + v.toLocaleString('es-CR')
                        },
                        min: 0
                    }
                }
            }
        });
    })();



    // Búsqueda
    function buscar(val) {
        aplicarFiltros(val.toLowerCase());
    }

    function aplicarFiltros(texto) {
        const q = texto ?? document.getElementById('buscar').value.toLowerCase();
        document.querySelectorAll('#tabla-proformas tbody tr[data-estado]').forEach(tr => {
            const estadoOk = filtroActivo === 'todas' || tr.dataset.estado === filtroActivo;
            const buscarOk = !q || tr.dataset.buscar.toLowerCase().includes(q);
            tr.style.display = estadoOk && buscarOk ? '' : 'none';
        });
    }
</script>
