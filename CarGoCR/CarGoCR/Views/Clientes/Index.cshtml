@model List<CarGoCR.Models.Cliente>

@{
    ViewData["Title"] = "Clientes";
}

<link rel="stylesheet"
      href="~/css/Clientes/Index.css"
      asp-append-version="true" />



<body>

            <div class="topbar-right">
                <div class="topbar-btn"><svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.73 21a2 2 0 0 1-3.46 0" /></svg><span class="notif-dot"></span></div>
                <div class="topbar-btn"><svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3" /><path d="M19.07 4.93A10 10 0 1 0 4.93 19.07 10 10 0 0 0 19.07 4.93z" /></svg></div>
                <div class="user-chip"><div class="user-avatar">AP</div><span class="user-name">Admin</span></div>
            </div>
        </div>

        <div class="content">
            <div class="page-header-row">
                <div class="page-header">
                    <h1>Clientes</h1>
                    <p>Gestiona y consulta toda tu base de clientes</p>
                </div>
                    <a asp-action="Create" class="btn-primary" style="text-decoration:none;">
                        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                            <line x1="12" y1="5" x2="12" y2="19" />
                            <line x1="5" y1="12" x2="19" y2="12" />
                        </svg>
                        Nuevo cliente
                    </a>
            </div>

            <div class="stats-grid">
                    <div class="stat-mini">
                        <div class="stat-mini-label">Total clientes</div>
                        <div class="stat-mini-val">
                            @Model.Count()
                        </div>
                    </div>

                    <div class="stat-mini">
                        <div class="stat-mini-label">Activos</div>
                        <div class="stat-mini-val green">
                            @Model.Count(c => c.Activo)
                        </div>
                    </div>

                    <div class="stat-mini">
                        <div class="stat-mini-label">Inactivos</div>
                        <div class="stat-mini-val">
                            @Model.Count(c => !c.Activo)
                        </div>
                    </div>

   
            </div>

            <div class="table-card">
                <div class="table-toolbar">
                    <div class="table-search">
                        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="color:var(--text-muted)"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                        <input type="text" placeholder="Buscar por nombre o email...">
                    </div>
                    <button class="btn-filter">
                        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3" /></svg>
                        Filtros
                    </button>
                </div>
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Cliente</th>
                                <th>Contacto</th>
                                <th>Compras</th>
                                <th>Total</th>
                                <th>Estado</th>
                                <th></th>
                            </tr>
                        </thead>
                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        @foreach (var cliente in Model)
                        {
                            <tr>
                                <td>
                                    <div class="client-cell">
                                        <div class="client-avatar" style="background:linear-gradient(135deg,#4f7cff,#a78bfa)">
                                            @(cliente.NombreCompleto.Substring(0, 1).ToUpper())
                                        </div>

                                        <div>
                                            <div class="client-name">
                                                @cliente.NombreCompleto
                                            </div>
                                            <div class="client-code">
                                                #@cliente.Id
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <div class="contact-line">
                                        @cliente.Correo
                                    </div>

                                    <div class="contact-line">
                                        @cliente.Telefono
                                    </div>
                                </td>

                                <td>
                                    @cliente.FechaRegistro.ToShortDateString()
                                </td>

                                <td>
                                    ₡0.00
                                </td>

                                <td>
                                    @if (cliente.Activo)
                                    {
                                        <span class="badge-active">
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-inactive">
                                            Inactivo
                                        </span>
                                    }
                                </td>

                                <td>
                                    <div style="display:flex; gap:5px;">
                                        <a asp-action="Details"
                                           asp-route-id="@cliente.Id"
                                           class="actions-btn"
                                           title="Ver">

                                            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z"></path>
                                                <circle cx="12" cy="12" r="3"></circle>
                                            </svg>
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@cliente.Id"
                                           class="actions-btn"
                                           title="Editar">

                                            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                <path d="M12 20h9"></path>
                                                <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
                                            </svg>
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@cliente.Id"
                                           class="actions-btn"
                                           title="Eliminar">

                                            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                <polyline points="3 6 5 6 21 6"></polyline>
                                                <path d="M19 6l-1 14H6L5 6"></path>
                                                <path d="M10 11v6"></path>
                                                <path d="M14 11v6"></path>
                                                <path d="M9 6V4h6v2"></path>
                                            </svg>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="empty-message">
                                No hay clientes registrados
                            </td>
                        </tr>
                    }

                </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
