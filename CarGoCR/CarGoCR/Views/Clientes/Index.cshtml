@model List<CarGoCR.Models.Cliente>

@{
    ViewData["Title"] = "Clientes";
}

<link rel="stylesheet" href="~/css/Clientes/Index.css" asp-append-version="true" />

<div class="content">
    <div class="page-header-row">
        <div class="page-header">
            <h1>Clientes</h1>
            <p>Gestiona y consulta toda tu base de clientes</p>
        </div>
        <a asp-action="Create" class="btn-primary" style="text-decoration:none;">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <line x1="12" y1="5" x2="12" y2="19" />
                <line x1="5" y1="12" x2="19" y2="12" />
            </svg>
            Nuevo cliente
        </a>
    </div>

    <div class="stats-grid">
        <div class="stat-mini">
            <div class="stat-mini-label">Total clientes</div>
            <div class="stat-mini-val">@Model.Count()</div>
        </div>
        <div class="stat-mini">
            <div class="stat-mini-label">Activos</div>
            <div class="stat-mini-val green">@Model.Count(c => c.Activo)</div>
        </div>
        <div class="stat-mini">
            <div class="stat-mini-label">Inactivos</div>
            <div class="stat-mini-val">@Model.Count(c => !c.Activo)</div>
        </div>
    </div>

    <div class="table-card">
        <div class="table-toolbar">
            <div class="table-search">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="color:var(--text-muted)">
                    <circle cx="11" cy="11" r="8" />
                    <line x1="21" y1="21" x2="16.65" y2="16.65" />
                </svg>
                <input type="text" id="searchInput" placeholder="Buscar por nombre o email..." oninput="filtrarClientes(this.value)" />
            </div>
            <button class="btn-filter">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3" />
                </svg>
                Filtros
            </button>
        </div>

        <!-- TABLA DESKTOP -->
        <table class="data-table" id="tablaClientes">
            <thead>
                <tr>
                    <th>Cliente</th>
                    <th>Contacto</th>
                    <th>Registro</th>
                    <th>Total</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var cliente in Model)
                    {
                        <tr data-buscar="@cliente.NombreCompleto.ToLower() @cliente.Correo?.ToLower()">
                            <td>
                                <div class="client-cell">
                                    <div class="client-avatar" style="background:linear-gradient(135deg,#4f7cff,#a78bfa)">
                                        @cliente.NombreCompleto.Substring(0, 1).ToUpper()
                                    </div>
                                    <div>
                                        <div class="client-name">@cliente.NombreCompleto</div>
                                        <div class="client-code">#@cliente.Id</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="contact-line">@cliente.Correo</div>
                                <div class="contact-line">@cliente.Telefono</div>
                            </td>
                            <td>@cliente.FechaRegistro.ToShortDateString()</td>
                            <td>₡0.00</td>
                            <td>
                                @if (cliente.Activo)
                                {
                                    <span class="badge-active">Activo</span>
                                }
                                else
                                {
                                    <span class="badge-inactive">Inactivo</span>
                                }
                            </td>
                            <td>
                                <div style="display:flex;gap:5px;">
                                    <a asp-action="Details" asp-route-id="@cliente.Id" class="actions-btn" title="Ver">
                                        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z" />
                                            <circle cx="12" cy="12" r="3" />
                                        </svg>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@cliente.Id" class="actions-btn" title="Editar">
                                        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                            <path d="M12 20h9" />
                                            <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" />
                                        </svg>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@cliente.Id" class="actions-btn" title="Eliminar">
                                        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                            <polyline points="3 6 5 6 21 6" />
                                            <path d="M19 6l-1 14H6L5 6" />
                                            <path d="M10 11v6" />
                                            <path d="M14 11v6" />
                                            <path d="M9 6V4h6v2" />
                                        </svg>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="empty-message">No hay clientes registrados</td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- CARDS MOBILE -->
        <div class="client-cards-mobile" id="cardsClientes">
            @if (Model != null && Model.Any())
            {
                var colores = new[] { "#4f7cff", "#a78bfa", "#34d399", "#fb923c", "#f87171", "#38bdf8" };

                @foreach (var cliente in Model)
                {
                    var initials = string.Join("", (cliente.NombreCompleto ?? "?")
                        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                        .Take(2)
                        .Select(w => w[0].ToString().ToUpper()));

                    var color = colores[Math.Abs((cliente.NombreCompleto ?? "").GetHashCode()) % colores.Length];

                    <div class="client-card-mobile" data-buscar="@cliente.NombreCompleto.ToLower() @cliente.Correo?.ToLower()">
                        <div class="client-card-mobile-top">
                            <div class="client-card-mobile-info">
                                <div class="client-avatar" style="background:@color">@initials</div>
                                <div class="client-card-mobile-meta">
                                    <span class="client-name">@cliente.NombreCompleto</span>
                                    <span class="client-code">#@cliente.Id</span>
                                </div>
                            </div>
                            @if (cliente.Activo)
                            {
                                <span class="badge-active">Activo</span>
                            }
                            else
                            {
                                <span class="badge-inactive">Inactivo</span>
                            }
                        </div>

                        <div class="client-card-mobile-contacts">
                            @if (!string.IsNullOrEmpty(cliente.Correo))
                            {
                                <div class="contact-line">
                                    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                                        <polyline points="22,6 12,13 2,6" />
                                    </svg>
                                    @cliente.Correo
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(cliente.Telefono))
                            {
                                <div class="contact-line">
                                    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
                                    </svg>
                                    @cliente.Telefono
                                </div>
                            }
                        </div>

                        <div class="client-card-mobile-actions">
                            <a asp-action="Details" asp-route-id="@cliente.Id">Ver</a>
                            <a asp-action="Edit" asp-route-id="@cliente.Id">Editar</a>
                            <a asp-action="Delete" asp-route-id="@cliente.Id" class="danger">Eliminar</a>
                        </div>
                    </div>
                }
            }
            else
            {
                <p style="text-align:center;padding:2rem;color:var(--text-muted);font-size:0.875rem;">
                    No hay clientes registrados
                </p>
            }
        </div>
    </div>
</div>

<script>
    function filtrarClientes(val) {
        const q = val.toLowerCase().trim();

        // Filtrar filas de tabla
        document.querySelectorAll('#tablaClientes tbody tr[data-buscar]').forEach(tr => {
            tr.style.display = !q || tr.dataset.buscar.includes(q) ? '' : 'none';
        });

        // Filtrar cards mobile
        document.querySelectorAll('#cardsClientes .client-card-mobile').forEach(card => {
            card.style.display = !q || card.dataset.buscar.includes(q) ? '' : 'none';
        });
    }
</script>