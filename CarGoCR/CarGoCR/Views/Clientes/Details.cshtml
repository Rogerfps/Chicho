@model CarGoCR.Models.Cliente

@{
    ViewData["Title"] = "Detalles del Cliente";
}
<link rel="stylesheet"
      href="~/css/Clientes/Details.css"
      asp-append-version="true" />

<div class="page-card">

    <h1 class="page-title">Detalles del Cliente</h1>

    <p class="page-subtitle">
        Información completa del cliente registrado.
    </p>

    <div class="info-grid">

        <div class="info-item">
            <span>ID</span>
            <strong>@Model.Id</strong>
        </div>

        <div class="info-item">
            <span>Nombre Completo</span>
            <strong>@Model.NombreCompleto</strong>
        </div>

        <div class="info-item">
            <span>Correo</span>
            <strong>@Model.Correo</strong>
        </div>

        <div class="info-item">
            <span>Teléfono</span>
            <strong>@Model.Telefono</strong>
        </div>

        <div class="info-item">
            <span>Cédula</span>
            <strong>@Model.Cedula</strong>
        </div>

        <div class="info-item">
            <span>Dirección</span>
            <strong>@Model.Direccion</strong>
        </div>

        <div class="info-item">
            <span>Estado</span>

            @if (Model.Activo)
            {
                <span class="badge-active">Activo</span>
            }
            else
            {
                <span class="badge-inactive">Inactivo</span>
            }

        </div>

        <div class="info-item">
            <span>Fecha Registro</span>
            <strong>@Model.FechaRegistro.ToShortDateString()</strong>
        </div>

    </div>

    <div class="action-buttons">

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn-edit">
                 Editar Cliente
            </a>

            <a asp-action="Index"
               class="btn-secondary-modern">
                ← Volver
            </a>

    </div>

</div>