@model CarGoCR.Models.Cliente

@{
    ViewData["Title"] = "Eliminar Cliente";
}


<link rel="stylesheet"
      href="~/css/Clientes/delete.css"
      asp-append-version="true" />

<div class="page-card">

    <h1 class="page-title text-danger">
        Eliminar Cliente
    </h1>

    <p class="page-subtitle">
        Esta acción no se puede deshacer.
    </p>

    <div class="warning-box">

        <h3>@Model.NombreCompleto</h3>

        <p>@Model.Correo</p>

        <p>@Model.Telefono</p>

        <p>@Model.Cedula</p>

    </div>

    <form asp-action="Delete" method="post">

        <input type="hidden" asp-for="Id" />

        <div class="action-buttons">

            <button type="submit" class="btn-delete">
                 Eliminar Cliente
            </button>

            <a asp-action="Index"
               class="btn-secondary-modern">
                Cancelar
            </a>

        </div>
    </form>

</div>