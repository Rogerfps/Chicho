@model CarGoCR.Models.Paquete

@{
    ViewData["Title"] = "Nuevo Paquete";
}

<style>



    .layout-content {
        margin-left: 220px;
        width: calc(100% - 220px);
        min-height: 100vh;
        padding: 2rem;
    }

    .page-container {
        padding-top: 30px;
        padding-bottom: 40px;
    }

    .form-card {
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 14px;
        padding: 2rem;
    }


    .page-header-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

    .page-header h1 {
        font-size: 2rem;
        font-weight: 800;
        margin-bottom: 5px;
        color: white;
    }

    .page-header p {
        color: #94a3b8;
        margin: 0;
    }

    .btn-secondary {
        background: #1e293b;
        color: white;
        border: 1px solid #334155;
        padding: 12px 22px;
        border-radius: 14px;
        font-weight: 600;
        transition: .3s;
    }

        .btn-secondary:hover {
            background: #334155;
            color: white;
            transform: translateY(-2px);
        }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(280px,1fr));
        gap: 20px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
    }

    .form-label {
        color: #cbd5e1;
        font-weight: 600;
        margin-bottom: 8px;
    }

    
    .form-input {
        background: var(--bg);
        border: 1px solid var(--card-border);
        color: var(--text-primary);
        padding: .75rem;
        border-radius: 8px;
    }

        .form-input:focus {
            outline: none;
            border-color: #3b82f6;
            box-shadow: 0 0 0 4px rgba(59,130,246,.15);
        }

        .form-input::placeholder {
            color: #64748b;
        }

    textarea.form-input {
        resize: none;
    }

    select.form-input {
        cursor: pointer;
    }

    .text-danger {
        margin-top: 6px;
        font-size: .85rem;
    }

    .checkbox-card {
        grid-column: span 2;
        background: rgba(15,23,42,.7);
        border: 1px solid #1e293b;
        border-radius: 18px;
        padding: 18px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

        .checkbox-card input[type="checkbox"] {
            width: 20px;
            height: 20px;
            cursor: pointer;
        }

        .checkbox-card label {
            color: #e2e8f0;
            font-weight: 600;
            margin: 0;
            cursor: pointer;
        }

    .form-actions {
        margin-top: 35px;
        padding-top: 25px;
        border-top: 1px solid rgba(148,163,184,.15);
        display: flex;
        gap: 15px;
    }

    .btn-primary {
        background: linear-gradient(135deg,#2563eb,#1d4ed8);
        border: none;
        color: white;
        padding: 14px 26px;
        border-radius: 14px;
        font-weight: 700;
        transition: .3s;
    }

        .btn-primary:hover {
            background: linear-gradient(135deg,#3b82f6,#2563eb);
            transform: translateY(-2px);
        }

    .card-section-title {
        color: white;
        font-size: 1.15rem;
        font-weight: 700;
        margin-bottom: 20px;
    }

    .form-group.full-width {
        grid-column: 1 / -1;
    }

    @@media(max-width:768px) {

        .layout-content {
            margin-left: 0;
            width: 100%;
            padding: 1rem;
        }

        .form-card {
            padding: 25px;
        }

        .checkbox-card {
            grid-column: span 1;
        }

        .form-actions {
            flex-direction: column;
        }
    }


    .layout-content {
        margin-left: 220px;
        width: calc(100% - 220px);
        min-height: 100vh;
        padding: 2rem;
    }
</style>

<div class="content">

    <div class="page-header-row">
        <div class="page-header">
            <h1>Nuevo Paquete</h1>
            <p>Registrar paquete recibido</p>
        </div>

        <a asp-action="Index"
           class="btn-secondary"
           style="text-decoration:none;">
            Volver
        </a>
    </div>

    <div class="form-card">

        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="form-grid">

                <div class="form-group">
                    <label asp-for="Tracking"
                           class="form-label">
                        Tracking
                    </label>

                    <input asp-for="Tracking"
                           class="form-input" />

                    <span asp-validation-for="Tracking"
                          class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ClienteId"
                           class="form-label">
                        Cliente
                    </label>

                    <select asp-for="ClienteId"
                            asp-items="ViewBag.Clientes"
                            class="form-input">
                        <option value="">
                            Seleccione un cliente
                        </option>
                    </select>

                    <span asp-validation-for="ClienteId"
                          class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Descripcion"
                           class="form-label">
                        Descripción
                    </label>

                    <input asp-for="Descripcion"
                           class="form-input" />

                    <span asp-validation-for="Descripcion"
                          class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Peso"
                           class="form-label">
                        Peso (kg)
                    </label>

                    <input asp-for="Peso"
                           type="number"
                           step="0.01"
                           class="form-input" />

                    <span asp-validation-for="Peso"
                          class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ValorDeclarado"
                           class="form-label">
                        Valor declarado
                    </label>

                    <input asp-for="ValorDeclarado"
                           type="number"
                           step="0.01"
                           class="form-input" />
                </div>

                <div class="form-group">
                    <label asp-for="Estado"
                           class="form-label">
                        Estado
                    </label>

                    <select asp-for="Estado"
                            class="form-input">

                        <option value="Prealertado">
                            Prealertado
                        </option>

                        <option value="Recibido en bodega USA">
                            Recibido en bodega USA
                        </option>

                        <option value="En tránsito">
                            En tránsito
                        </option>

                        <option value="En aduanas">
                            En aduanas
                        </option>

                        <option value="Disponible para retiro">
                            Disponible para retiro
                        </option>

                        <option value="Entregado">
                            Entregado
                        </option>

                    </select>
                </div>

                <div class="form-group full-width">
                    <label asp-for="Observaciones"
                           class="form-label">
                        Observaciones
                    </label>

                    <textarea asp-for="Observaciones"
                              class="form-input"
                              rows="5"></textarea>
                </div>
                <div class="checkbox-card">
                    <input asp-for="Pagado" type="checkbox" />

                    <label asp-for="Pagado">
                        Paquete pagado
                    </label>
                </div>

            </div>
            <div class="form-actions">

                <button type="submit"
                        class="btn-primary">
                    Guardar Paquete
                </button>

                <a asp-action="Index"
                   class="btn-secondary"
                   style="text-decoration:none;">
                    Cancelar
                </a>

            </div>
        </form>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}