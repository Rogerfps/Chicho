@model List<CarGoCR.Models.Paquete>

@{
    ViewData["Title"] = "Paquetes";
}

<style>


    .content {
        width: 100%;
        max-width: 100%;
        padding: 2rem;
        box-sizing: border-box;
    }

    .page-header-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }

    .page-header h1 {
        color: white;
        font-size: 2rem;
        font-weight: 800;
        margin-bottom: 5px;
    }

    .page-header p {
        color: #94a3b8;
        margin: 0;
    }

    .btn-primary {
        background: linear-gradient(135deg,#2563eb,#1d4ed8);
        color: white;
        border: none;
        padding: 14px 22px;
        border-radius: 14px;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: .3s;
    }

        .btn-primary:hover {
            transform: translateY(-2px);
            color: white;
            box-shadow: 0 12px 25px rgba(37,99,235,.35);
        }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(3,minmax(220px,1fr));
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .stat-mini {
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 16px;
        padding: 1.5rem;
        transition: .2s;
    }

        .stat-mini:hover {
            transform: translateY(-3px);
        }

    .stat-mini-label {
        color: var(--text-secondary);
        font-size: .8rem;
        margin-bottom: .5rem;
    }

    .stat-mini-val {
        font-size: 2rem;
        font-weight: 700;
        color: var(--text-primary);
    }

        .stat-mini-val.blue {
            color: var(--accent-blue);
        }

        .stat-mini-val.green {
            color: var(--accent-green);
        }


    .table-card {
        background: var(--card-bg);
        border: 1px solid rgba(59,130,246,.15);
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 15px 35px rgba(0,0,0,.25);
    }

    .table-toolbar {
        padding: 20px 25px;
        border-bottom: 1px solid rgba(148,163,184,.15);
    }

    .table-search {
        position: relative;
        width: 350px;
    }

        .table-search svg {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
        }

        .table-search input {
            width: 100%;
            background: #0f172a;
            border: 1px solid #334155;
            color: white;
            border-radius: 14px;
            padding: 12px 14px 12px 40px;
        }

            .table-search input:focus {
                outline: none;
                border-color: #3b82f6;
                box-shadow: 0 0 0 4px rgba(59,130,246,.15);
            }

    .data-table {
        width: 100%;
        border-collapse: collapse;
    }

        .data-table thead {
            background: rgba(15,23,42,.8);
        }

        .data-table th {
            color: #94a3b8;
            font-weight: 700;
            text-transform: uppercase;
            font-size: .75rem;
            letter-spacing: .5px;
            padding: 18px;
        }

        .data-table td {
            padding: 18px;
            color: #e2e8f0;
            border-top: 1px solid rgba(148,163,184,.08);
            vertical-align: middle;
        }

        .data-table tbody tr {
            transition: .25s;
        }

            .data-table tbody tr:hover {
                background: rgba(59,130,246,.05);
            }

    .badge-active {
        background: rgba(34,197,94,.15);
        color: #22c55e;
        padding: 8px 14px;
        border-radius: 999px;
        font-size: .8rem;
        font-weight: 700;
    }

    .badge-inactive {
        background: rgba(239,68,68,.15);
        color: #ef4444;
        padding: 8px 14px;
        border-radius: 999px;
        font-size: .8rem;
        font-weight: 700;
    }

    .actions-btn {
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        text-decoration: none;
        background: #0f172a;
        border: 1px solid #1e293b;
        color: #cbd5e1;
        transition: .25s;
    }

        .actions-btn:hover {
            background: #2563eb;
            color: white;
            border-color: #2563eb;
            transform: translateY(-2px);
        }

    .empty-message {
        text-align: center;
        color: #94a3b8;
        padding: 60px !important;
        font-size: 1rem;
    }

    .data-table strong {
        color: #60a5fa;
        font-size: .95rem;
        letter-spacing: .5px;
    }

    .tracking-code {
        background: rgba(59,130,246,.15);
        color: #60a5fa;
        padding: 8px 12px;
        border-radius: 10px;
        font-weight: 700;
        font-size: .85rem;
    }
    .layout-content {
        margin-left: 220px;
        width: calc(100% - 220px);
        min-height: 100vh;
        padding: 2rem;
    }



</style>


<div class="content">

    <div class="page-header-row">
        <div class="page-header">
            <h1>Paquetes</h1>
            <p>Gestión de paquetes y envíos</p>
        </div>

        <a asp-action="Create"
           class="btn-primary"
           style="text-decoration:none;">

            <svg width="14" height="14"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2.5"
                 viewBox="0 0 24 24">
                <line x1="12" y1="5" x2="12" y2="19" />
                <line x1="5" y1="12" x2="19" y2="12" />
            </svg>

            Nuevo paquete
        </a>
    </div>

    <div class="stats-grid">

        <div class="stat-mini">
            <div class="stat-mini-label">
                Total paquetes
            </div>

            <div class="stat-mini-val">
                @Model.Count()
            </div>
        </div>

        <div class="stat-mini">
            <div class="stat-mini-label">
                Entregados
            </div>

            <div class="stat-mini-val green">
                @Model.Count(x => x.Estado == "Entregado")
            </div>
        </div>

        <div class="stat-mini">
            <div class="stat-mini-label">
                Pendientes
            </div>

            <div class="stat-mini-val blue">
                @Model.Count(x => x.Estado != "Entregado")
            </div>
        </div>

    </div>

    <div class="table-card">

        <div class="table-toolbar">

            <div class="table-search">

                <svg width="14"
                     height="14"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     viewBox="0 0 24 24"
                     style="color:var(--text-muted)">
                    <circle cx="11" cy="11" r="8" />
                    <line x1="21"
                          y1="21"
                          x2="16.65"
                          y2="16.65" />
                </svg>

                <input type="text"
                       placeholder="Buscar tracking..." />

            </div>

        </div>

        <table class="data-table">

            <thead>
                <tr>
                    <th>Tracking</th>
                    <th>Cliente</th>
                    <th>Peso</th>
                    <th>Costo</th>
                    <th>Estado</th>
                    <th>Pagado</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>

                @if (Model.Any())
                {
                    @foreach (var paquete in Model)
                    {
                        <tr>

                            <td>
                                <span class="tracking-code">
                                    @paquete.Tracking
                                </span>
                            </td>

                            <td>
                                @paquete.Cliente?.NombreCompleto
                            </td>

                            <td>
                                @paquete.Peso Kg
                            </td>

                            <td>
                                ₡@paquete.CostoEnvio.ToString("N2")
                            </td>

                            <td>

                                @if (paquete.Estado == "Entregado")
                                {
                                    <span class="badge-active">
                                        @paquete.Estado
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-inactive">
                                        @paquete.Estado
                                    </span>
                                }

                            </td>

                            <td>

                                @if (paquete.Pagado)
                                {
                                    <span class="badge-active">
                                        Sí
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-inactive">
                                        No
                                    </span>
                                }

                            </td>

                            <td>

                                <div style="display:flex; gap:5px;">

                                    <a asp-action="Details"
                                       asp-route-id="@paquete.Id"
                                       class="actions-btn">

                                        <svg width="16"
                                             height="16"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="2"
                                             viewBox="0 0 24 24">
                                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z"></path>
                                            <circle cx="12"
                                                    cy="12"
                                                    r="3"></circle>
                                        </svg>

                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@paquete.Id"
                                       class="actions-btn">

                                        <svg width="16"
                                             height="16"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="2"
                                             viewBox="0 0 24 24">
                                            <path d="M12 20h9"></path>
                                            <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
                                        </svg>

                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@paquete.Id"
                                       class="actions-btn">

                                        <svg width="16"
                                             height="16"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="2"
                                             viewBox="0 0 24 24">
                                            <polyline points="3 6 5 6 21 6"></polyline>
                                            <path d="M19 6l-1 14H6L5 6"></path>
                                            <path d="M10 11v6"></path>
                                            <path d="M14 11v6"></path>
                                            <path d="M9 6V4h6v2"></path>
                                        </svg>

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7"
                            class="empty-message">

                            No hay paquetes registrados

                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>