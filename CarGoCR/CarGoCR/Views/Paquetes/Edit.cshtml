@model CarGoCR.Models.Paquete

@{
    ViewData["Title"] = "Editar Paquete";
}

<link rel="stylesheet" href="~/css/Paquetes/Edit.css" asp-append-version="true" />


<div class="content">

    <div class="page-header-row">
        <div class="page-header">
            <h1>Editar Paquete</h1>
            <p>Modificar información del paquete</p>
        </div>

        <a asp-action="Index"
           class="btn-primary"
           style="text-decoration:none;">
            Volver
        </a>
    </div>

    <div class="form-card">

        <form asp-action="Edit">

            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="card-section-title">
                Información del Paquete
            </div>

            <div class="form-grid">

                <div class="form-group">
                    <label class="form-label">
                        Tracking
                    </label>

                    <input asp-for="Tracking"
                           class="form-input"
                           readonly />
                </div>

                <div class="form-group">
                    <label class="form-label">
                        Descripción
                    </label>

                    <input asp-for="Descripcion"
                           class="form-input" />

                    <span asp-validation-for="Descripcion"
                          class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label class="form-label">
                        Peso (kg)
                    </label>

                    <input asp-for="Peso"
                           class="form-input" />

                    <span asp-validation-for="Peso"
                          class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label class="form-label">
                        Valor declarado
                    </label>

                    <input asp-for="ValorDeclarado"
                           class="form-input" />
                </div>

                <div class="form-group">
                    <label class="form-label">
                        Cliente
                    </label>

                    <select asp-for="ClienteId"
                            class="form-input">

                        @foreach (var cliente in ViewBag.Clientes)
                        {
                            <option value="@cliente.Id">
                                @cliente.NombreCompleto
                            </option>
                        }

                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label">
                        Tarifa
                    </label>

                    <select asp-for="TarifaId"
                            class="form-input">

                        <option value="">
                            Seleccione una tarifa
                        </option>

                        @foreach (var tarifa in ViewBag.Tarifas)
                        {
                            <option value="@tarifa.Id">
                                @tarifa.Categoria
                            </option>
                        }

                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label">
                        Estado
                    </label>

                    <select asp-for="Estado"
                            class="form-input">

                        <option>Prealertado</option>
                        <option>Recibido</option>
                        <option>En Bodega</option>
                        <option>En Tránsito</option>
                        <option>Listo para Entrega</option>
                        <option>Entregado</option>

                    </select>
                </div>

                <div class="form-group full-width">
                    <label class="form-label">
                        Observaciones
                    </label>

                    <textarea asp-for="Observaciones"
                              class="form-input"
                              rows="5"></textarea>
                </div>

                <div class="checkbox-card">

                    <input asp-for="Pagado" />

                    <label asp-for="Pagado">
                        El paquete ya fue pagado
                    </label>

                </div>

            </div>

            <div class="form-actions">

                <button type="submit"
                        class="btn-primary">
                    Guardar Cambios
                </button>

                <a asp-action="Index"
                   class="btn-secondary"
                   style="text-decoration:none;">
                    Cancelar
                </a>

            </div>

        </form>

    </div>

</div>