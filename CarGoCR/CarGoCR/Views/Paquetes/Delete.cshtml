@model CarGoCR.Models.Paquete

@{
    ViewData["Title"] = "Eliminar Paquete";
}
<link rel="stylesheet" href="~/css/Paquetes/delete.css" asp-append-version="true" />


<div class="content">

    <div class="delete-card">

        <div class="warning-header">

            <div class="warning-icon">

                <svg width="40"
                     height="40"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     viewBox="0 0 24 24">

                    <path d="M12 9v4"></path>
                    <path d="M12 17h.01"></path>
                    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>

                </svg>

            </div>

            <div class="warning-title">
                Eliminar Paquete
            </div>

            <div class="warning-text">
                Esta acción eliminará permanentemente el paquete del sistema.
            </div>

        </div>

        <div class="package-details">

            <div class="details-grid">

                <div class="detail-card">
                    <div class="detail-label">Tracking</div>
                    <div class="detail-value">
                        <span class="tracking-badge">
                            @Model.Tracking
                        </span>
                    </div>
                </div>

                <div class="detail-card">
                    <div class="detail-label">Cliente</div>
                    <div class="detail-value">
                        @Model.Cliente?.NombreCompleto
                    </div>
                </div>

                <div class="detail-card">
                    <div class="detail-label">Descripción</div>
                    <div class="detail-value">
                        @Model.Descripcion
                    </div>
                </div>

                <div class="detail-card">
                    <div class="detail-label">Peso</div>
                    <div class="detail-value">
                        @Model.Peso Kg
                    </div>
                </div>

                <div class="detail-card">
                    <div class="detail-label">Estado</div>
                    <div class="detail-value">
                        @Model.Estado
                    </div>
                </div>

                <div class="detail-card">
                    <div class="detail-label">Costo de envío</div>
                    <div class="detail-value">
                        ₡ @Model.CostoEnvio.ToString("N2")
                    </div>
                </div>

            </div>

        </div>

        <form asp-action="Delete">

            <input type="hidden" asp-for="Id" />

            <div class="actions">

                <button type="submit"
                        class="btn-delete">
                    Eliminar Paquete
                </button>

                <a asp-action="Index"
                   class="btn-cancel">
                    Cancelar
                </a>

            </div>

        </form>

    </div>

</div>