@model CarGoCR.Models.Paquete

@{
    ViewData["Title"] = "Detalle del Paquete";
}
<link rel="stylesheet" href="~/css/Paquetes/Details.css" asp-append-version="true" />

<div class="content">

    <div class="page-header-row">
        <div class="page-header">
            <h1>Detalle del Paquete</h1>
            <p>Información completa del paquete</p>
        </div>

        <a asp-action="Index"
           class="btn-primary"
           style="text-decoration:none;">
            Volver
        </a>
    </div>

    <div class="details-card">

        <div class="package-header">

            <div class="tracking-box">
                <span class="tracking-label">Tracking</span>
                <span class="tracking-value">@Model.Tracking</span>
            </div>

            @if (Model.Estado == "Entregado")
            {
                <span class="badge-active">Entregado</span>
            }
            else
            {
                <span class="badge-inactive">@Model.Estado</span>
            }

        </div>

        <div class="info-grid">

            <div class="info-card">
                <div class="info-label">Descripción</div>
                <div class="info-value">@Model.Descripcion</div>
            </div>

            <div class="info-card">
                <div class="info-label">Peso</div>
                <div class="info-value">@Model.Peso Kg</div>
            </div>

            <div class="info-card">
                <div class="info-label">Valor Declarado</div>
                <div class="info-value">₡ @Model.ValorDeclarado.ToString("N2")</div>
            </div>

            <div class="info-card">
                <div class="info-label">Costo de Envío</div>
                <div class="info-value">₡ @Model.CostoEnvio.ToString("N2")</div>
            </div>

            <div class="info-card">
                <div class="info-label">Cliente</div>
                <div class="info-value">@Model.Cliente?.NombreCompleto</div>
            </div>

            <div class="info-card">
                <div class="info-label">Tarifa</div>
                <div class="info-value">@Model.Tarifa?.Categoria</div>
            </div>

            <div class="info-card">
                <div class="info-label">Pagado</div>

                @if (Model.Pagado)
                {
                    <span class="badge-active">Sí</span>
                }
                else
                {
                    <span class="badge-inactive">No</span>
                }
            </div>

            <div class="info-card">
                <div class="info-label">Fecha Recepción</div>
                <div class="info-value">
                    @Model.FechaRecepcion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                </div>
            </div>

            @if (Model.FechaEntrega.HasValue)
            {
                <div class="info-card">
                    <div class="info-label">Fecha Entrega</div>
                    <div class="info-value">
                        @Model.FechaEntrega.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                    </div>
                </div>
            }

        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Observaciones))
        {
            <div class="observaciones">

                <div class="observaciones-title">
                    Observaciones
                </div>

                <div>
                    @Model.Observaciones
                </div>

            </div>
        }

    </div>
</div>