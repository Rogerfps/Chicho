@model CarGoCR.Models.Paquete

@{
    ViewData["Title"] = "Detalle del Paquete";
}

<style>

        .layout-content {
            margin-left: 220px;
            width: calc(100% - 220px);
            min-height: 100vh;
            padding: 2rem;
        }

        .page-header-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }

        .page-header h1 {
            color: #fff;
            font-size: 2rem;
            font-weight: 800;
            margin-bottom: 5px;
        }

        .page-header p {
            color: #94a3b8;
            margin: 0;
        }

        .details-card {
        background: var(--card-bg);
        border: 1px solid rgba(148,163,184,.15);
            border-radius: 24px;
            padding: 35px;
            box-shadow: 0 20px 50px rgba(0,0,0,.35);
        }

        .package-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 1px solid rgba(148,163,184,.15);
        }

        .tracking-box {
            display: flex;
            flex-direction: column;
        }

        .tracking-label {
            color: #94a3b8;
            font-size: .85rem;
        }

        .tracking-value {
            color: #fff;
            font-size: 1.5rem;
            font-weight: 800;
        }

        .info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit,minmax(250px,1fr));
            gap: 20px;
        }

        .info-card {
            background: rgba(15,23,42,.7);
            border: 1px solid rgba(148,163,184,.1);
            border-radius: 18px;
            padding: 18px;
        }

        .info-label {
            color: #94a3b8;
            font-size: .85rem;
            margin-bottom: 8px;
        }

        .info-value {
            color: #fff;
            font-size: 1.05rem;
            font-weight: 600;
        }

        .observaciones {
            margin-top: 25px;
            background: rgba(15,23,42,.7);
            border: 1px solid rgba(148,163,184,.1);
            border-radius: 18px;
            padding: 20px;
        }

        .observaciones-title {
            color: white;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .badge-active {
            background: #16a34a;
            color: white;
            padding: 8px 14px;
            border-radius: 999px;
            font-size: .85rem;
            font-weight: 600;
        }

        .badge-inactive {
            background: #dc2626;
            color: white;
            padding: 8px 14px;
            border-radius: 999px;
            font-size: .85rem;
            font-weight: 600;
        }

        .btn-primary {
            background: linear-gradient(135deg,#2563eb,#1d4ed8);
            border: none;
            color: white;
            padding: 12px 24px;
            border-radius: 14px;
            font-weight: 700;
            transition: .3s;
        }

            .btn-primary:hover {
                color: white;
                transform: translateY(-2px);
            }

        @@media(max-width:768px) {

            .layout-content {
                margin-left: 0;
                width: 100%;
                padding: 1rem;
            }

            .page-header-row {
                flex-direction: column;
                align-items: flex-start;
                gap: 15px;
            }

            .package-header {
                flex-direction: column;
                align-items: flex-start;
                gap: 15px;
            }
        }

    .layout-content {
        margin-left: 220px;
        width: calc(100% - 220px);
        min-height: 100vh;
        padding: 2rem;
</style>

<div class="content">

    <div class="page-header-row">
        <div class="page-header">
            <h1>Detalle del Paquete</h1>
            <p>Información completa del paquete</p>
        </div>

        <a asp-action="Index"
           class="btn-primary"
           style="text-decoration:none;">
            Volver
        </a>
    </div>

    <div class="details-card">

        <div class="package-header">

            <div class="tracking-box">
                <span class="tracking-label">Tracking</span>
                <span class="tracking-value">@Model.Tracking</span>
            </div>

            @if (Model.Estado == "Entregado")
            {
                <span class="badge-active">Entregado</span>
            }
            else
            {
                <span class="badge-inactive">@Model.Estado</span>
            }

        </div>

        <div class="info-grid">

            <div class="info-card">
                <div class="info-label">Descripción</div>
                <div class="info-value">@Model.Descripcion</div>
            </div>

            <div class="info-card">
                <div class="info-label">Peso</div>
                <div class="info-value">@Model.Peso Kg</div>
            </div>

            <div class="info-card">
                <div class="info-label">Valor Declarado</div>
                <div class="info-value">₡ @Model.ValorDeclarado.ToString("N2")</div>
            </div>

            <div class="info-card">
                <div class="info-label">Costo de Envío</div>
                <div class="info-value">₡ @Model.CostoEnvio.ToString("N2")</div>
            </div>

            <div class="info-card">
                <div class="info-label">Cliente</div>
                <div class="info-value">@Model.Cliente?.NombreCompleto</div>
            </div>

            <div class="info-card">
                <div class="info-label">Tarifa</div>
                <div class="info-value">@Model.Tarifa?.Categoria</div>
            </div>

            <div class="info-card">
                <div class="info-label">Pagado</div>

                @if (Model.Pagado)
                {
                    <span class="badge-active">Sí</span>
                }
                else
                {
                    <span class="badge-inactive">No</span>
                }
            </div>

            <div class="info-card">
                <div class="info-label">Fecha Recepción</div>
                <div class="info-value">
                    @Model.FechaRecepcion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                </div>
            </div>

            @if (Model.FechaEntrega.HasValue)
            {
                <div class="info-card">
                    <div class="info-label">Fecha Entrega</div>
                    <div class="info-value">
                        @Model.FechaEntrega.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                    </div>
                </div>
            }

        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Observaciones))
        {
            <div class="observaciones">

                <div class="observaciones-title">
                    Observaciones
                </div>

                <div>
                    @Model.Observaciones
                </div>

            </div>
        }

    </div>