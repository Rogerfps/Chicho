@model List<CarGoCR.Models.Proforma>

@{
    ViewData["Title"] = "Proformas";
}
<link rel="stylesheet" href="~/css/Proformas/Index.css" asp-append-version="true" />


<div class="content">

    <div class="page-header-row">
        <div class="page-header">
            <h1>Proformas</h1>
            <p>Facturas pendientes y pagadas</p>
        </div>

        <a asp-action="Create"
           class="btn-primary"
           style="text-decoration:none;display:flex;align-items:center;gap:8px;">

            <svg width="16"
                 height="16"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2.5"
                 viewBox="0 0 24 24">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>

            Nueva Proforma

        </a>
    </div>

    <div class="stats-grid">

        <div class="stat-mini">
            <div class="stat-mini-label">
                Total Proformas
            </div>
            <div class="stat-mini-val">
                @Model.Count()
            </div>
        </div>

        <div class="stat-mini">
            <div class="stat-mini-label">
                Pendientes
            </div>
            <div class="stat-mini-val blue">
                @Model.Count(x => !x.Pagada)
            </div>
        </div>

        <div class="stat-mini">
            <div class="stat-mini-label">
                Pagadas
            </div>
            <div class="stat-mini-val green">
                @Model.Count(x => x.Pagada)
            </div>
        </div>

    </div>

    <div class="table-card">

        <table class="data-table">

            <thead>
                <tr>
                    <th>#</th>
                    <th>Cliente</th>
                    <th>Fecha</th>
                    <th>Paquetes</th>
                    <th>Total</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>

                @if (Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                <span class="proforma-id">
                                    #@item.Id
                                </span>
                            </td>

                            <td>
                                @item.Cliente?.NombreCompleto
                            </td>

                            <td>
                                @item.FechaCreacion.ToString("dd/MM/yyyy")
                            </td>

                            <td>
                                @item.Detalles.Count
                            </td>

                            <td>
                                ₡@item.Total.ToString("N2")
                            </td>

                            <td>

                                @if (item.Pagada)
                                {
                                    <span class="badge-active">
                                        Pagada
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-inactive">
                                        Pendiente
                                    </span>
                                }

                            </td>

                            <td>

                                <div class="action-buttons">

                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="action-btn view-btn"
                                       title="Ver">

                                        <svg width="16"
                                             height="16"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="2"
                                             viewBox="0 0 24 24">
                                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z"></path>
                                            <circle cx="12"
                                                    cy="12"
                                                    r="3"></circle>
                                        </svg>

                                    </a>

                                    @if (!item.Pagada)
                                    {
                                        <a asp-action="Aprobar"
                                           asp-route-id="@item.Id"
                                           class="action-btn approve-btn"
                                           title="Confirmar Pago">

                                            <svg width="16"
                                                 height="16"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="2"
                                                 viewBox="0 0 24 24">
                                                <polyline points="20 6 9 17 4 12"></polyline>
                                            </svg>

                                        </a>
                                    }

                                    <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="action-btn delete-btn"
                                       title="Eliminar">

                                        <svg width="16"
                                             height="16"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="2"
                                             viewBox="0 0 24 24">
                                            <polyline points="3 6 5 6 21 6"></polyline>
                                            <path d="M19 6l-1 14H6L5 6"></path>
                                            <path d="M10 11v6"></path>
                                            <path d="M14 11v6"></path>
                                            <path d="M9 6V4h6v2"></path>
                                        </svg>

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7"
                            class="empty-message">

                            No hay proformas registradas

                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>