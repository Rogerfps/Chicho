@model List<CarGoCR.Models.Proforma>

@{
    ViewData["Title"] = "Proformas";
}


<style>
    .content {
        width: 100%;
    }

    .page-header-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
    }

    .page-header h1 {
        color: var(--text-primary);
        font-size: 2rem;
        font-weight: 800;
        margin-bottom: .3rem;
    }

    .page-header p {
        color: var(--text-secondary);
        margin: 0;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(220px,1fr));
        gap: 1rem;
        margin-bottom: 1.75rem;
    }

    .stat-mini {
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 18px;
        padding: 1.25rem;
        transition: .3s;
    }

        .stat-mini:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(0,0,0,.15);
        }

    .stat-mini-label {
        color: var(--text-secondary);
        font-size: .85rem;
        margin-bottom: .5rem;
    }

    .stat-mini-val {
        font-size: 2rem;
        font-weight: 800;
        color: var(--text-primary);
    }

    .table-card {
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 20px;
        overflow: hidden;
    }

    .data-table {
        width: 100%;
        border-collapse: collapse;
    }

        .data-table thead {
            background: rgba(255,255,255,.02);
        }

        .data-table th {
            color: var(--text-secondary);
            font-size: .85rem;
            font-weight: 700;
            padding: 1rem;
            border-bottom: 1px solid var(--card-border);
        }

        .data-table td {
            padding: 1rem;
            color: var(--text-primary);
            border-bottom: 1px solid rgba(255,255,255,.04);
            vertical-align: middle;
        }

        .data-table tbody tr {
            transition: .25s;
        }

            .data-table tbody tr:hover {
                background: rgba(255,255,255,.03);
            }

    .proforma-id {
        font-weight: 800;
        color: var(--text-primary);
    }

    .badge-active,
    .badge-inactive {
        padding: .45rem .9rem;
        border-radius: 999px;
        font-size: .75rem;
        font-weight: 700;
    }

    .actions-group {
        display: flex;
        gap: .5rem;
    }

    .actions-btn {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        transition: .25s;
        background: rgba(255,255,255,.03);
        border: 1px solid rgba(255,255,255,.05);
    }

        .actions-btn:hover {
            transform: translateY(-2px);
            background: rgba(255,255,255,.06);
        }

    .empty-message {
        text-align: center;
        padding: 3rem !important;
        color: var(--text-secondary);
    }

    .btn-primary {
        border-radius: 14px;
        padding: 12px 22px;
        font-weight: 700;
        transition: .3s;
    }

        .btn-primary:hover {
            transform: translateY(-2px);
        }

    .action-buttons {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .action-btn {
        width: 38px;
        height: 38px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        transition: all .25s ease;
        border: 1px solid var(--card-border);
        background: rgba(255,255,255,.03);
    }

        .action-btn svg {
            width: 16px;
            height: 16px;
        }

        .action-btn:hover {
            transform: translateY(-2px);
        }


    .view-btn {
        color: #60a5fa;
        background: rgba(96,165,250,.10);
    }

        .view-btn:hover {
            background: rgba(96,165,250,.18);
            box-shadow: 0 0 15px rgba(96,165,250,.25);
        }


    .approve-btn {
        color: #34d399;
        background: rgba(52,211,153,.10);
    }

        .approve-btn:hover {
            background: rgba(52,211,153,.18);
            box-shadow: 0 0 15px rgba(52,211,153,.25);
        }


    .delete-btn {
        color: #f87171;
        background: rgba(248,113,113,.10);
    }

        .delete-btn:hover {
            background: rgba(248,113,113,.18);
            box-shadow: 0 0 15px rgba(248,113,113,.25);
        }

    .layout-content {
        margin-left: 220px;
        width: calc(100% - 220px);
        min-height: 100vh;
        padding: 2rem;
    }
</style>

<div class="content">

    <div class="page-header-row">
        <div class="page-header">
            <h1>Proformas</h1>
            <p>Facturas pendientes y pagadas</p>
        </div>

        <a asp-action="Create"
           class="btn-primary"
           style="text-decoration:none;display:flex;align-items:center;gap:8px;">

            <svg width="16"
                 height="16"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2.5"
                 viewBox="0 0 24 24">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>

            Nueva Proforma

        </a>
    </div>

    <div class="stats-grid">

        <div class="stat-mini">
            <div class="stat-mini-label">
                Total Proformas
            </div>
            <div class="stat-mini-val">
                @Model.Count()
            </div>
        </div>

        <div class="stat-mini">
            <div class="stat-mini-label">
                Pendientes
            </div>
            <div class="stat-mini-val blue">
                @Model.Count(x => !x.Pagada)
            </div>
        </div>

        <div class="stat-mini">
            <div class="stat-mini-label">
                Pagadas
            </div>
            <div class="stat-mini-val green">
                @Model.Count(x => x.Pagada)
            </div>
        </div>

    </div>

    <div class="table-card">

        <table class="data-table">

            <thead>
                <tr>
                    <th>#</th>
                    <th>Cliente</th>
                    <th>Fecha</th>
                    <th>Paquetes</th>
                    <th>Total</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>

                @if (Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                <span class="proforma-id">
                                    #@item.Id
                                </span>
                            </td>

                            <td>
                                @item.Cliente?.NombreCompleto
                            </td>

                            <td>
                                @item.FechaCreacion.ToString("dd/MM/yyyy")
                            </td>

                            <td>
                                @item.Detalles.Count
                            </td>

                            <td>
                                ₡@item.Total.ToString("N2")
                            </td>

                            <td>

                                @if (item.Pagada)
                                {
                                    <span class="badge-active">
                                        Pagada
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-inactive">
                                        Pendiente
                                    </span>
                                }

                            </td>

                            <td>

                                <div class="action-buttons">

                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="action-btn view-btn"
                                       title="Ver">

                                        <svg width="16"
                                             height="16"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="2"
                                             viewBox="0 0 24 24">
                                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z"></path>
                                            <circle cx="12"
                                                    cy="12"
                                                    r="3"></circle>
                                        </svg>

                                    </a>

                                    @if (!item.Pagada)
                                    {
                                        <a asp-action="Aprobar"
                                           asp-route-id="@item.Id"
                                           class="action-btn approve-btn"
                                           title="Confirmar Pago">

                                            <svg width="16"
                                                 height="16"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="2"
                                                 viewBox="0 0 24 24">
                                                <polyline points="20 6 9 17 4 12"></polyline>
                                            </svg>

                                        </a>
                                    }

                                    <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="action-btn delete-btn"
                                       title="Eliminar">

                                        <svg width="16"
                                             height="16"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="2"
                                             viewBox="0 0 24 24">
                                            <polyline points="3 6 5 6 21 6"></polyline>
                                            <path d="M19 6l-1 14H6L5 6"></path>
                                            <path d="M10 11v6"></path>
                                            <path d="M14 11v6"></path>
                                            <path d="M9 6V4h6v2"></path>
                                        </svg>

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7"
                            class="empty-message">

                            No hay proformas registradas

                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>