@model CarGoCR.Models.Proforma

@{
    ViewData["Title"] = "Eliminar Proforma";
}
<link rel="stylesheet" href="~/css/Proformas/delete.css" asp-append-version="true" />


<div class="content">

    <div class="page-header-row">

        <div class="page-header">
            <h1>Eliminar Proforma</h1>
            <p>Confirmar eliminación de la proforma</p>
        </div>

        <a asp-action="Index"
           class="btn-secondary"
           style="text-decoration:none;">
            Volver
        </a>

    </div>

    <div class="warning-card">

        <div class="warning-title">
            ⚠ Esta acción no se puede deshacer
        </div>

        <div>
            Se eliminará la proforma y todos sus detalles asociados.
        </div>

    </div>

    <div class="details-card">

        <div class="details-row">
            <div class="details-label">Proforma</div>
            <div class="details-value">
                #@Model.Id
            </div>
        </div>

        <div class="details-row">
            <div class="details-label">Cliente</div>
            <div class="details-value">
                @Model.Cliente?.NombreCompleto
            </div>
        </div>

        <div class="details-row">
            <div class="details-label">Fecha</div>
            <div class="details-value">
                @Model.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
            </div>
        </div>

        <div class="details-row">
            <div class="details-label">Estado</div>
            <div class="details-value">
                @Model.Estado
            </div>
        </div>

        <div class="details-row">
            <div class="details-label">Pagada</div>
            <div class="details-value">
                @(Model.Pagada ? "Sí" : "No")
            </div>
        </div>

        <div class="details-row">
            <div class="details-label">Total</div>
            <div class="details-value">
                ₡@Model.Total.ToString("N2")
            </div>
        </div>

    </div>

    <form asp-action="Delete"
          method="post"
          style="margin-top:1.5rem;">

        <input type="hidden"
               asp-for="Id" />

        <div style="display:flex; gap:10px;">

            <button type="submit"
                    class="danger-btn">
                Eliminar Proforma
            </button>

            <a asp-action="Details"
               asp-route-id="@Model.Id"
               class="btn-secondary"
               style="text-decoration:none;">
                Cancelar
            </a>

        </div>

    </form>

</div>