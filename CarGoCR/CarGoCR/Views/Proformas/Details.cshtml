@model CarGoCR.Models.Proforma

@{
    ViewData["Title"] = "Detalle de Proforma";
}

<style>
    .layout-content {
        margin-left: 220px;
        width: calc(100% - 220px);
        min-height: 100vh;
        padding: 2rem;
    }

    .page-header-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
        gap: 1rem;
    }

    .page-header h1 {
        color: var(--text-primary);
        font-size: 2rem;
        font-weight: 800;
        margin-bottom: .3rem;
    }

    .page-header p {
        color: var(--text-secondary);
        margin: 0;
    }

    .header-actions {
        display: flex;
        gap: .75rem;
        flex-wrap: wrap;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(260px,1fr));
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .info-card {
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 18px;
        padding: 1.25rem;
        transition: .3s;
    }

        .info-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(0,0,0,.18);
        }

    .info-label {
        color: var(--text-secondary);
        font-size: .8rem;
        text-transform: uppercase;
        letter-spacing: .5px;
        margin-bottom: .5rem;
    }

    .info-value {
        color: var(--text-primary);
        font-weight: 700;
        font-size: 1rem;
    }

    .observaciones-card {
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 18px;
        padding: 1.25rem;
        margin-bottom: 1.5rem;
    }

    .table-card {
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 18px;
        overflow: hidden;
        margin-top: 1rem;
    }

    .table-header {
        padding: 1rem 1.5rem;
        border-bottom: 1px solid var(--card-border);
        font-weight: 700;
        color: var(--text-primary);
    }

    .data-table {
        width: 100%;
        border-collapse: collapse;
    }

        .data-table thead {
            background: rgba(255,255,255,.02);
        }

        .data-table th {
            text-align: left;
            padding: 1rem;
            color: var(--text-secondary);
            font-size: .85rem;
            font-weight: 700;
            border-bottom: 1px solid var(--card-border);
        }

        .data-table td {
            padding: 1rem;
            color: var(--text-primary);
            border-bottom: 1px solid rgba(255,255,255,.05);
        }

        .data-table tbody tr {
            transition: .2s;
        }

            .data-table tbody tr:hover {
                background: rgba(255,255,255,.03);
            }

    .badge-active {
        background: rgba(52,211,153,.12);
        color: #34d399;
        padding: .4rem .9rem;
        border-radius: 999px;
        font-size: .75rem;
        font-weight: 700;
    }

    .badge-inactive {
        background: rgba(248,113,113,.12);
        color: #f87171;
        padding: .4rem .9rem;
        border-radius: 999px;
        font-size: .75rem;
        font-weight: 700;
    }

    .total-box {
        margin-top: 1.5rem;
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 18px;
        padding: 1.5rem;
        text-align: right;
    }

    .total-label {
        color: var(--text-secondary);
        font-size: .85rem;
        margin-bottom: .3rem;
    }

    .total-value {
        color: var(--text-primary);
        font-size: 2rem;
        font-weight: 800;
    }

    .btn-primary,
    .btn-secondary {
        border-radius: 12px;
        padding: 12px 20px;
        font-weight: 600;
        transition: .3s;
    }

        .btn-primary:hover,
        .btn-secondary:hover {
            transform: translateY(-2px);
        }
.btn-secondary {
    background: #111827;
    border: 1px solid #374151;
    color: white;
    padding: 12px 22px;
    border-radius: 14px;
    font-weight: 700;
    transition: .3s;
}

.btn-secondary:hover {
    background: #1f2937;
    border-color: #4f7cff;
    transform: translateY(-2px);
}
   
</style>

<div class="content">

    <div class="page-header-row">

        <div class="page-header">
            <h1>Proforma #@Model.Id</h1>
            <p>Detalle completo de la proforma</p>
        </div>

        <div class="header-actions">

            @if (!Model.Pagada)
            {
                <a asp-action="Aprobar"
                   asp-route-id="@Model.Id"
                   class="btn-primary"
                   style="text-decoration:none;">
                    Confirmar Pago
                </a>
            }

            <a asp-action="Imprimir"
               asp-route-id="@Model.Id"
               class="btn-primary"
               style="text-decoration:none;">
                Descargar PDF
            </a>

            <a asp-action="Index"
               class="btn-secondary"
               style="text-decoration:none;">

                <svg width="16"
                     height="16"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2.5"
                     viewBox="0 0 24 24">
                    <path d="M15 18l-6-6 6-6" />
                </svg>

                Volver

            </a>

        </div>

    </div>

    <div class="info-grid">

        <div class="info-card">
            <div class="info-label">
                Cliente
            </div>

            <div class="info-value">
                @Model.Cliente?.NombreCompleto
            </div>
        </div>

        <div class="info-card">
            <div class="info-label">
                Fecha
            </div>

            <div class="info-value">
                @Model.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
            </div>
        </div>

        <div class="info-card">
            <div class="info-label">
                Estado
            </div>

            <div class="info-value">

                @if (Model.Pagada)
                {
                    <span class="badge-active">
                        Aprobada
                    </span>
                }
                else
                {
                    <span class="badge-inactive">
                        Pendiente
                    </span>
                }

            </div>
        </div>

        <div class="info-card">
            <div class="info-label">
                Total
            </div>

            <div class="info-value">
                ₡@Model.Total.ToString("N2")
            </div>
        </div>

    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Observaciones))
    {
        <div class="info-card" style="margin-bottom:1rem;">
            <div class="info-label">
                Observaciones
            </div>

            <div class="info-value">
                @Model.Observaciones
            </div>
        </div>
    }

    <div class="table-card">

        <table class="data-table">

            <thead>
                <tr>
                    <th>Tracking</th>
                    <th>Descripción</th>
                    <th>Peso</th>
                    <th>Costo</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var detalle in Model.Detalles)
                {
                    <tr>

                        <td>
                            @detalle.Paquete?.Tracking
                        </td>

                        <td>
                            @detalle.Paquete?.Descripcion
                        </td>

                        <td>
                            @detalle.Paquete?.Peso kg
                        </td>

                        <td>
                            ₡@detalle.Precio.ToString("N2")
                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

    <div class="total-box">
        Total Facturado: ₡@Model.Total.ToString("N2")
    </div>

</div>