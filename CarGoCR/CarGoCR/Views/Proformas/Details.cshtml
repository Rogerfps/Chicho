@model CarGoCR.Models.Proforma

@{
    ViewData["Title"] = "Detalle de Proforma";
}

<link rel="stylesheet" href="~/css/Proformas/Details.css" asp-append-version="true" />

   

<div class="content">

    <div class="page-header-row">

        <div class="page-header">
            <h1>Proforma #@Model.Id</h1>
            <p>Detalle completo de la proforma</p>
        </div>

        <div class="header-actions">

            @if (!Model.Pagada)
            {
                <a asp-action="Aprobar"
                   asp-route-id="@Model.Id"
                   class="btn-primary"
                   style="text-decoration:none;">
                    Confirmar Pago
                </a>
            }

            <a asp-action="Imprimir"
               asp-route-id="@Model.Id"
               class="btn-primary"
               style="text-decoration:none;">
                Descargar PDF
            </a>

            <a asp-action="Index"
               class="btn-secondary"
               style="text-decoration:none;">

                <svg width="16"
                     height="16"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2.5"
                     viewBox="0 0 24 24">
                    <path d="M15 18l-6-6 6-6" />
                </svg>

                Volver

            </a>

        </div>

    </div>

    <div class="info-grid">

        <div class="info-card">
            <div class="info-label">
                Cliente
            </div>

            <div class="info-value">
                @Model.Cliente?.NombreCompleto
            </div>
        </div>

        <div class="info-card">
            <div class="info-label">
                Fecha
            </div>

            <div class="info-value">
                @Model.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
            </div>
        </div>

        <div class="info-card">
            <div class="info-label">
                Estado
            </div>

            <div class="info-value">

                @if (Model.Pagada)
                {
                    <span class="badge-active">
                        Aprobada
                    </span>
                }
                else
                {
                    <span class="badge-inactive">
                        Pendiente
                    </span>
                }

            </div>
        </div>

        <div class="info-card">
            <div class="info-label">
                Total
            </div>

            <div class="info-value">
                ₡@Model.Total.ToString("N2")
            </div>
        </div>

    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Observaciones))
    {
        <div class="info-card" style="margin-bottom:1rem;">
            <div class="info-label">
                Observaciones
            </div>

            <div class="info-value">
                @Model.Observaciones
            </div>
        </div>
    }

    <div class="table-card">

        <table class="data-table">

            <thead>
                <tr>
                    <th>Tracking</th>
                    <th>Descripción</th>
                    <th>Peso</th>
                    <th>Costo</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var detalle in Model.Detalles)
                {
                    <tr>

                        <td>
                            @detalle.Paquete?.Tracking
                        </td>

                        <td>
                            @detalle.Paquete?.Descripcion
                        </td>

                        <td>
                            @detalle.Paquete?.Peso kg
                        </td>

                        <td>
                            ₡@detalle.Precio.ToString("N2")
                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

    <div class="total-box">
        Total Facturado: ₡@Model.Total.ToString("N2")
    </div>

</div>