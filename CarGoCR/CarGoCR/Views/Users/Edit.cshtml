@model CarGoCR.Models.ApplicationUser

@{
    ViewData["Title"] = "Editar Usuario";
}

<link rel="stylesheet" href="~/css/Usuarios/Edit.css" asp-append-version="true" />

<div class="content">

    <div class="page-header-row">
        <div class="page-header">
            <h1>Editar Usuario</h1>
            <p>Actualizar información del usuario</p>
        </div>

        <a asp-action="Index"
           class="btn-primary"
           style="text-decoration:none;">
            Volver
        </a>
    </div>

    <div class="form-card">

        <form asp-action="Edit" method="post">

            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="form-grid">

                <div class="form-group">
                    <label asp-for="NombreCompleto"
                           class="form-label">
                        Nombre Completo
                    </label>

                    <input asp-for="NombreCompleto"
                           class="form-input" />
                </div>

                <div class="form-group">
                    <label asp-for="UserName"
                           class="form-label">
                        Usuario
                    </label>

                    <input asp-for="UserName"
                           class="form-input" />
                </div>

                <div class="form-group">
                    <label asp-for="Email"
                           class="form-label">
                        Correo
                    </label>

                    <input asp-for="Email"
                           class="form-input" />
                </div>

                <div class="form-group">
                    <label asp-for="PhoneNumber"
                           class="form-label">
                        Teléfono
                    </label>

                    <input asp-for="PhoneNumber"
                           class="form-input" />
                </div>

            </div>

            <div class="checkbox-group">

                <input asp-for="Activo" />

                <label asp-for="Activo">
                    Usuario activo
                </label>

            </div>

            <div class="form-actions">

                <button type="submit"
                        class="btn-primary">
                    Guardar cambios
                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}