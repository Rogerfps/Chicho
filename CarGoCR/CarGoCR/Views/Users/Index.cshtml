@model List<CarGoCR.Models.ApplicationUser>

@{
    ViewData["Title"] = "Usuarios";
}

<style>
    <style >

        .content {
            width: 100%;
            max-width: 100%;
            padding: 2rem;
            box-sizing: border-box;
        }

        .main {
            flex: 1;
            width: 100%;
        }

        .layout-content {
            margin-left: 220px;
            width: calc(100% - 220px);
            min-height: 100vh;
            padding: 2rem;
        }

        /* HEADER */

        .page-header-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.8rem;
        }

        .page-header h1 {
            color: var(--text-primary);
            font-size: 1.8rem;
            font-weight: 700;
        }

        .page-header p {
            color: var(--text-secondary);
            margin-top: .25rem;
        }

        /* STATS */

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(3,minmax(220px,1fr));
            gap: 1rem;
            margin-bottom: 1.5rem;
        }

        .stat-mini {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 16px;
            padding: 1.5rem;
            transition: .2s;
        }

            .stat-mini:hover {
                transform: translateY(-3px);
            }

        .stat-mini-label {
            color: var(--text-secondary);
            font-size: .8rem;
            margin-bottom: .5rem;
        }

        .stat-mini-val {
            font-size: 2rem;
            font-weight: 700;
            color: var(--text-primary);
        }

            .stat-mini-val.blue {
                color: var(--accent-blue);
            }

            .stat-mini-val.green {
                color: var(--accent-green);
            }

        /* TABLA */

        .table-card {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 15px 40px rgba(0,0,0,.15);
        }

        .table-toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1.25rem 1.5rem;
            border-bottom: 1px solid var(--card-border);
        }

        .table-search {
            display: flex;
            align-items: center;
            gap: .7rem;
            background: var(--bg);
            border: 1px solid var(--card-border);
            border-radius: 10px;
            padding: .75rem 1rem;
            width: 100%;
            max-width: 400px;
        }

            .table-search input {
                background: transparent;
                border: none;
                outline: none;
                color: var(--text-primary);
                width: 100%;
            }

                .table-search input::placeholder {
                    color: var(--text-muted);
                }

        .data-table {
            width: 100%;
            border-collapse: collapse;
        }

            .data-table th {
                text-align: left;
                padding: 1rem 1.5rem;
                color: var(--text-secondary);
                font-size: .75rem;
                text-transform: uppercase;
                letter-spacing: .5px;
                border-bottom: 1px solid var(--card-border);
            }

            .data-table td {
                padding: 1rem 1.5rem;
                border-bottom: 1px solid rgba(255,255,255,.04);
                color: var(--text-primary);
            }

            .data-table tbody tr {
                transition: .2s;
            }

                .data-table tbody tr:hover {
                    background: rgba(255,255,255,.02);
                }

                .data-table tbody tr:last-child td {
                    border-bottom: none;
                }

        /* USUARIO */

        .client-cell {
            display: flex;
            align-items: center;
            gap: .9rem;
        }

        .client-avatar {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            color: white;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .client-name {
            font-weight: 600;
            color: var(--text-primary);
        }

        .client-code {
            font-size: .75rem;
            color: var(--text-secondary);
        }

        /* BADGES */

        .badge-active {
            background: rgba(52,211,153,.15);
            color: var(--accent-green);
            padding: .4rem .9rem;
            border-radius: 999px;
            font-size: .75rem;
            font-weight: 600;
        }

        .badge-inactive {
            background: rgba(248,113,113,.15);
            color: var(--accent-red);
            padding: .4rem .9rem;
            border-radius: 999px;
            font-size: .75rem;
            font-weight: 600;
        }

        /* BOTONES DE ACCION */

        .actions-btn {
            width: 34px;
            height: 34px;
            border-radius: 8px;
            background: transparent;
            border: 1px solid var(--card-border);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-secondary);
            transition: .2s;
            text-decoration: none;
        }

            .actions-btn:hover {
                background: var(--hover-bg);
                color: var(--text-primary);
                transform: translateY(-2px);
            }

        /* VACIO */

        .empty-message {
            text-align: center;
            padding: 3rem !important;
            color: var(--text-secondary);
            font-size: .95rem;
        }



    .layout-content {
        margin-left: 220px;
        width: calc(100% - 220px);
        min-height: 100vh;
        padding: 2rem;
    }

</style>

<div class="content">
    <div class="page-header-row">
        <div class="page-header">
            <h1>Usuarios</h1>
            <p>Gestiona los usuarios del sistema</p>
        </div>

        <a asp-action="Create"
           class="btn-primary"
           style="text-decoration:none;">

            <svg width="14" height="14"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2.5"
                 viewBox="0 0 24 24">
                <line x1="12" y1="5" x2="12" y2="19" />
                <line x1="5" y1="12" x2="19" y2="12" />
            </svg>

            Nuevo usuario
        </a>
    </div>

    <div class="stats-grid">
        <div class="stat-mini">
            <div class="stat-mini-label">
                Total usuarios
            </div>

            <div class="stat-mini-val">
                @Model.Count()
            </div>
        </div>

        <div class="stat-mini">
            <div class="stat-mini-label">
                Con email
            </div>

            <div class="stat-mini-val blue">
                @Model.Count(x => !string.IsNullOrEmpty(x.Email))
            </div>
        </div>

        <div class="stat-mini">
            <div class="stat-mini-label">
                Con teléfono
            </div>

            <div class="stat-mini-val green">
                @Model.Count(x => !string.IsNullOrEmpty(x.PhoneNumber))
            </div>
        </div>
    </div>

    <div class="table-card">
        <div class="table-toolbar">
            <div class="table-search">
                <svg width="14"
                     height="14"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     viewBox="0 0 24 24"
                     style="color:var(--text-muted)">
                    <circle cx="11" cy="11" r="8" />
                    <line x1="21"
                          y1="21"
                          x2="16.65"
                          y2="16.65" />
                </svg>

                <input type="text"
                       placeholder="Buscar usuarios..." />
            </div>
        </div>

        <table class="data-table">
            <thead>
                <tr>
                    <th>Usuario</th>
                    <th>Email</th>
                    <th>Teléfono</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>

                @if (Model != null && Model.Any())
                {
                    @foreach (var usuario in Model)
                    {
                        <tr>
                            <td>
                                <div class="client-cell">

                                    <div class="client-avatar"
                                         style="background:linear-gradient(135deg,#4f7cff,#a78bfa)">
                                        @(usuario.UserName?.Substring(0, 1).ToUpper())
                                    </div>

                                    <div>
                                        <div class="client-name">
                                            @usuario.UserName
                                        </div>

                                        <div class="client-code">
                                            @usuario.Id
                                        </div>
                                    </div>

                                </div>
                            </td>

                            <td>
                                @usuario.Email
                            </td>

                            <td>
                                @usuario.PhoneNumber
                            </td>

                            <td>
                                @if (usuario.EmailConfirmed)
                                {
                                    <span class="badge-active">
                                        Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-inactive">
                                        Pendiente
                                    </span>
                                }
                            </td>

                            <td>
                                <div style="display:flex; gap:5px;">

                                    <a asp-action="Details"
                                       asp-route-id="@usuario.Id"
                                       class="actions-btn"
                                       title="Ver">

                                        <svg width="16"
                                             height="16"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="2"
                                             viewBox="0 0 24 24">
                                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z"></path>
                                            <circle cx="12"
                                                    cy="12"
                                                    r="3"></circle>
                                        </svg>

                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@usuario.Id"
                                       class="actions-btn"
                                       title="Editar">

                                        <svg width="16"
                                             height="16"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="2"
                                             viewBox="0 0 24 24">
                                            <path d="M12 20h9"></path>
                                            <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
                                        </svg>

                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@usuario.Id"
                                       class="actions-btn"
                                       title="Eliminar">

                                        <svg width="16"
                                             height="16"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="2"
                                             viewBox="0 0 24 24">
                                            <polyline points="3 6 5 6 21 6"></polyline>
                                            <path d="M19 6l-1 14H6L5 6"></path>
                                            <path d="M10 11v6"></path>
                                            <path d="M14 11v6"></path>
                                            <path d="M9 6V4h6v2"></path>
                                        </svg>

                                    </a>

                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="empty-message">
                            No hay usuarios registrados
                        </td>
                    </tr>
                }

            </tbody>
        </table>
    </div>
</div>