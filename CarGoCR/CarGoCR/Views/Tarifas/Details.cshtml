@model CarGoCR.Models.Tarifa

@{
    ViewData["Title"] = "Detalles de Tarifa";
}

<link rel="stylesheet" href="~/css/Tarifas/Details.css" asp-append-version="true" />


<div class="container page-container">

    <div class="row justify-content-center">

        <div class="col-lg-10">

            <div class="details-card">

                <h1 class="page-title">
                    Detalles de Tarifa
                </h1>

                <p class="page-subtitle">
                    Información completa de la tarifa registrada
                </p>

                <div class="info-grid">

                    <div class="info-card">

                        <div class="info-label">
                            Categoría
                        </div>

                        <div class="info-value">
                            @Model.Categoria
                        </div>

                    </div>

                    <div class="info-card">

                        <div class="info-label">
                            Peso mínimo
                        </div>

                        <div class="info-value">
                            @Model.PesoMinimo kg
                        </div>

                    </div>

                    <div class="info-card">

                        <div class="info-label">
                            Peso máximo
                        </div>

                        <div class="info-value">
                            @Model.PesoMaximo kg
                        </div>

                    </div>

                    <div class="info-card">

                        <div class="info-label">
                            Precio nacional
                        </div>

                        <div class="info-value" style="color:#34d399;">
                            $@Model.PrecioNacional
                        </div>

                    </div>

                    <div class="info-card">

                        <div class="info-label">
                            Precio internacional
                        </div>

                        <div class="info-value" style="color:#4f7cff;">
                            $@Model.PrecioInternacional
                        </div>

                    </div>

                    <div class="info-card">

                        <div class="info-label">
                            Cotización personalizada
                        </div>

                        <div class="info-value">

                            @if (Model.RequiereCotizacion)
                            {
                                <span class="cotizacion">
                                    Requiere cotización
                                </span>
                            }
                            else
                            {
                                <span>
                                    No requerida
                                </span>
                            }

                        </div>

                    </div>

                    <div class="info-card">

                        <div class="info-label">
                            Estado
                        </div>

                        <div class="info-value">

                            @if (Model.Activo)
                            {
                                <span class="status-active">
                                    Activa
                                </span>
                            }
                            else
                            {
                                <span class="status-inactive">
                                    Inactiva
                                </span>
                            }

                        </div>

                    </div>

                </div>
                <div class="action-buttons">

                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn-edit">
                         Editar Tarifa
                    </a>

                    <a asp-action="Index"
                       class="btn-back">
                        ← Volver
                    </a>

                </div>
            </div>

        </div>

    </div>

</div>