@model CarGoCR.Models.Tarifa

@{
    ViewData["Title"] = "Nueva Tarifa";
}

<link rel="stylesheet" href="~/css/Tarifas/Create.css" asp-append-version="true" />


<div class="container page-container">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="form-card">

                <h1 class="page-title">
                    Nueva Tarifa
                </h1>

                <p class="page-subtitle">
                    Configura precios de envíos y categorías
                </p>

                <form asp-action="Create" method="post">

                    <div class="section-title">
                        Información General
                    </div>

                    <div class="mb-4">

                        <label asp-for="Categoria"
                               class="form-label"></label>

                        <input asp-for="Categoria"
                               class="form-control"
                               placeholder="Ej: Paquete pequeño" />

                        <span asp-validation-for="Categoria"
                              class="text-danger"></span>

                    </div>

                    <div class="row">

                        <div class="col-md-6 mb-4">

                            <label asp-for="PesoMinimo"
                                   class="form-label"></label>

                            <input asp-for="PesoMinimo"
                                   class="form-control"
                                   placeholder="0.5" />

                            <span asp-validation-for="PesoMinimo"
                                  class="text-danger"></span>

                        </div>

                        <div class="col-md-6 mb-4">

                            <label asp-for="PesoMaximo"
                                   class="form-label"></label>

                            <input asp-for="PesoMaximo"
                                   class="form-control"
                                   placeholder="2" />

                            <span asp-validation-for="PesoMaximo"
                                  class="text-danger"></span>

                        </div>

                    </div>

                    <div class="section-title mt-3">
                        Precios
                    </div>

                    <div class="row">

                        <div class="col-md-6 mb-4">

                            <label asp-for="PrecioNacional"
                                   class="form-label"></label>

                            <input asp-for="PrecioNacional"
                                   class="form-control"
                                   placeholder="15" />

                            <span asp-validation-for="PrecioNacional"
                                  class="text-danger"></span>

                        </div>

                        <div class="col-md-6 mb-4">

                            <label asp-for="PrecioInternacional"
                                   class="form-label"></label>

                            <input asp-for="PrecioInternacional"
                                   class="form-control"
                                   placeholder="45" />

                            <span asp-validation-for="PrecioInternacional"
                                  class="text-danger"></span>

                        </div>

                    </div>

                    <div class="form-check mb-4">

                        <input asp-for="RequiereCotizacion"
                               class="form-check-input" />

                        <label asp-for="RequiereCotizacion"
                               class="form-check-label">

                            Requiere cotización personalizada

                        </label>

                    </div>

                    <div class="form-check mb-5">

                        <input asp-for="Activo"
                               class="form-check-input" />

                        <label asp-for="Activo"
                               class="form-check-label">

                            Tarifa activa

                        </label>

                    </div>

                    <div class="action-buttons">
                        <button type="submit" class="btn-save">
                             Guardar Tarifa
                        </button>

                        <a asp-action="Index" class="btn-back">
                            ← Volver
                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}