@model CarGoCR.Models.Tarifa

@{
    ViewData["Title"] = "Eliminar Tarifa";
}
<link rel="stylesheet" href="~/css/Tarifas/delete.css" asp-append-version="true" />


<div class="container page-container">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="delete-card">

                <div class="warning-icon">
                    ⚠
                </div>

                <h1 class="page-title">
                    Eliminar Tarifa
                </h1>

                <p class="page-subtitle">
                    Esta acción eliminará permanentemente la tarifa seleccionada
                </p>

                <div class="info-box">

                    <div class="info-row">

                        <span class="info-label">
                            Categoría
                        </span>

                        <span class="info-value">
                            @Model.Categoria
                        </span>

                    </div>

                    <div class="info-row">

                        <span class="info-label">
                            Rango de peso
                        </span>

                        <span class="info-value">
                            @Model.PesoMinimo kg - @Model.PesoMaximo kg
                        </span>

                    </div>

                    <div class="info-row">

                        <span class="info-label">
                            Precio nacional
                        </span>

                        <span class="info-value">
                            $@Model.PrecioNacional
                        </span>

                    </div>

                    <div class="info-row">

                        <span class="info-label">
                            Precio internacional
                        </span>

                        <span class="info-value">
                            $@Model.PrecioInternacional
                        </span>

                    </div>

                    <div class="info-row">

                        <span class="info-label">
                            Estado
                        </span>

                        <span class="info-value">

                            @if (Model.Activo)
                            {
                                <span class="status-active">
                                    Activa
                                </span>
                            }
                            else
                            {
                                <span class="status-inactive">
                                    Inactiva
                                </span>
                            }

                        </span>

                    </div>

                </div>

                <form asp-action="Delete" method="post">

                    <input type="hidden" asp-for="Id" />

                    <div class="d-flex justify-content-center gap-3 mt-4">

                        <button type="submit"
                                class="btn-delete">

                            Eliminar Tarifa

                        </button>

                        <a asp-action="Index"
                           class="btn-cancel">

                            Cancelar

                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>